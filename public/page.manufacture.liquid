{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Manufacture Studio — OFFCOMFRT</title>
{% comment %}
  OFFCOMFRT — Manufacture Studio (Control Tower, manufacturer side)
  Monochromatic B&W portal scoped to this manufacturer's samples and
  production orders. Talks to the Render backend. Deploy: save as
  templates/page.manufacture.liquid, then assign the template to a page.
{% endcomment %}
<script src="https://cdn.tailwindcss.com"></script>
<style>
  body, html { background: #fafaf9; }
  body { font-family: "Inter", ui-sans-serif, system-ui, -apple-system, sans-serif; }
  .font-mono { font-family: ui-monospace, "SF Mono", "JetBrains Mono", monospace; }
  .spin { animation: mfspin 1s linear infinite; } @keyframes mfspin { to { transform: rotate(360deg); } }
  .mf-fade { animation: mffade .4s cubic-bezier(0.4,0,0.2,1) both; }
  @keyframes mffade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  input[type="date"]::-webkit-calendar-picker-indicator { opacity: .45; }
</style>
</head>
<body>
<div id="app"></div>

<script>
/* ============================== CONSTANTS ============================== */
const API_BASE = "https://exchange-return-tracking.onrender.com/api/manufacture";
const STATUS_OPTIONS = ["Not Started", "Requested", "In Progress", "In Transit", "Received", "Under Review", "Revision Required", "Awaiting Manufacturer", "Awaiting Offcomfrt", "Approved", "Rejected", "Cancelled", "Closed"];
const STAGE_OPTIONS = ["Request", "Tech Pack", "Sampling", "Courier", "Fit Review", "Revision", "Approval", "Pre-Production", "Closed"];
const COMM_STATUS_OPTIONS = ["Open", "Waiting for Manufacturer", "Waiting for Offcomfrt", "Done", "Escalated"];
const REVISION_STATUS_OPTIONS = ["Not Started", "In Progress", "Completed", "Overdue"];
const PROD_STAGE_OPTIONS = ["PO Placed", "Fabric Sourcing", "Cutting", "Stitching", "Washing & Finishing", "Quality Check", "Packing", "Shipped", "Delivered"];
const FILE_TYPE_OPTIONS = ["Tech Pack", "Front Photo", "Back Photo", "Detail Photo", "Fit Photo", "QC Photo", "Fabric Photo", "Reference Image", "Invoice", "Courier", "Other"];
const PROD_FILE_TYPE_OPTIONS = ["Purchase Order", "Invoice", "Packing List", "Shipping Bill", "Inspection Report", "Photo", "Other"];
const PROD_QC_RESULT_OPTIONS = ["Pending", "Pass", "Fail", "Hold"];
const PROD_QC_CHECKPOINTS = ["Inline Inspection", "Pre-Final Inspection", "Final Random Inspection (AQL 2.5)", "Other"];

const TOKEN_KEY = "mf_mfr_token";
let TOKEN = localStorage.getItem(TOKEN_KEY);
let WS = null;      // { samples, productionOrders, techPacks, manufacturer, manufacturerName }
let TAB = "dashboard";

/* ============================== ICONS ============================== */
const ICONS = {
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  check: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  alert: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  package: '<path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 8.7 5 8.7-5"/>',
  clipboard: '<rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/>',
  message: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  ruler: '<path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.4 2.4 0 0 1 0-3.4l2.6-2.6a2.4 2.4 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/>',
  paperclip: '<path d="m16 6-8.414 8.414a2 2 0 0 0 2.828 2.828L18.828 8.828a4 4 0 0 0-5.656-5.656L4.757 11.586a6 6 0 0 0 8.486 8.486L21 12.343"/>',
  dashboard: '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>',
  files: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M8 13h8"/><path d="M8 17h5"/>',
  truck: '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  loader: '<path d="M21 12a9 9 0 1 1-6.219-8.56"/>'
};
function icon(name, size = 14, cls = "") {
  return '<svg xmlns="http://www.w3.org/2000/svg" width="' + size + '" height="' + size + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="' + cls + '">' + ICONS[name] + '</svg>';
}

/* ============================== HELPERS ============================== */
const DAY = 86400000;
const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
function todayISO() { const d = new Date(); d.setHours(0, 0, 0, 0); return d.toISOString().slice(0, 10); }
function daysDiff(iso) { if (!iso) return null; const d = new Date(iso + "T00:00:00"); const t = new Date(todayISO() + "T00:00:00"); return Math.round((d - t) / DAY); }
function fmtDate(iso) { if (!iso) return "—"; const d = new Date(iso + "T00:00:00"); return d.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "2-digit" }); }
function uid(prefix) { return prefix + "-" + Math.random().toString(36).slice(2, 9).toUpperCase(); }

function statusLight(s) {
  if (s.stage === "Closed") return "grey";
  const due = s.nextDue || s.targetDate;
  const dr = daysDiff(due);
  if (dr == null) return "grey";
  if (dr < 0) return "red";
  if (dr <= 2) return "yellow";
  return "green";
}
function daysRemaining(s) { return daysDiff(s.nextDue || s.targetDate); }
function daysOverdue(s) {
  const dr = daysRemaining(s);
  if (dr == null || s.stage === "Closed") return 0;
  return dr < 0 ? -dr : 0;
}
function orderQty(o) { return (o.breakdown || []).reduce((sum, r) => sum + (Number(r.qty) || 0), 0); }
function productionLight(o) {
  if (o.currentStage === "Delivered") return "grey";
  const dr = daysDiff(o.expectedDelivery);
  if (dr == null) return "grey";
  if (dr < 0) return "red";
  if (dr <= 5) return "yellow";
  return "green";
}
const LIGHT_DOT = { green: "bg-emerald-500", yellow: "bg-amber-500", red: "bg-rose-500", grey: "bg-neutral-300" };
const LIGHT_TEXT = { green: "text-emerald-700", yellow: "text-amber-700", red: "text-rose-700", grey: "text-neutral-500" };
const LIGHT_BG = { green: "bg-emerald-50", yellow: "bg-amber-50", red: "bg-rose-50", grey: "bg-neutral-100" };
const LIGHT_LABEL = { green: "On track", yellow: "Due soon", red: "Overdue", grey: "Closed" };
const LIGHT_ORDER = { red: 0, yellow: 1, green: 2, grey: 3 };

/* ============================== PRIMITIVES ============================== */
function dot(light) { return `<span class="inline-block w-2 h-2 rounded-full ${LIGHT_DOT[light]}"></span>`; }
function statusPill(light) {
  return `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[11px] font-medium rounded-sm ${LIGHT_BG[light]} ${LIGHT_TEXT[light]}">${dot(light)} ${LIGHT_LABEL[light]}</span>`;
}
function kpi(label, value, accent = "") {
  return `<div class="px-4 py-3 border-r border-neutral-200 last:border-r-0">
    <div class="text-[10px] font-semibold tracking-wider uppercase text-neutral-400 mb-1">${esc(label)}</div>
    <div class="text-2xl font-black font-mono tabular-nums ${accent || "text-neutral-900"}">${value}</div>
  </div>`;
}
function bar(label, count, max) {
  const pct = max > 0 ? Math.max(3, Math.round((count / max) * 100)) : 0;
  return `<div class="flex items-center gap-3 py-1.5">
    <div class="w-28 text-xs text-neutral-600 shrink-0">${esc(label)}</div>
    <div class="flex-1 h-4 bg-neutral-100 rounded-sm overflow-hidden"><div class="h-full bg-neutral-800 rounded-sm transition-all" style="width:${pct}%"></div></div>
    <div class="w-6 text-xs font-mono text-neutral-700 text-right shrink-0">${count}</div>
  </div>`;
}
function sectionHeading(index, title) {
  return `<div class="flex items-center justify-between mb-3 mt-8 first:mt-0">
    <h2 class="text-[13px] font-bold tracking-wide text-neutral-900 flex items-baseline gap-2">
      <span class="text-neutral-300 font-mono">${esc(index)}</span><span class="uppercase">${esc(title)}</span>
    </h2></div>`;
}
function emptyState(iconName, title, hint) {
  return `<div class="flex flex-col items-center justify-center text-center py-14 border border-dashed border-neutral-300 rounded-sm bg-neutral-50 mf-fade">
    ${icon(iconName, 22, "text-neutral-300 mb-3")}
    <p class="text-sm font-medium text-neutral-600">${esc(title)}</p>
    ${hint ? `<p class="text-xs text-neutral-400 mt-1 max-w-xs">${esc(hint)}</p>` : ""}</div>`;
}
function field(label, inner, span = false) {
  return `<label class="flex flex-col gap-1 ${span ? "col-span-2" : ""}">
    <span class="text-[10px] font-semibold tracking-wider uppercase text-neutral-400">${esc(label)}</span>${inner}</label>`;
}
function readField(label, value, span = false) {
  return `<div class="flex flex-col gap-1 ${span ? "col-span-2" : ""}">
    <span class="text-[10px] font-semibold tracking-wider uppercase text-neutral-400">${esc(label)}</span>
    <div class="w-full border border-neutral-200 bg-neutral-50 rounded-sm px-2.5 py-1.5 text-sm text-neutral-600 min-h-[33px] whitespace-pre-wrap">${esc(value ?? "") || "—"}</div>
  </div>`;
}
const INPUT_CLS = 'w-full border border-neutral-300 rounded-sm px-2.5 py-1.5 text-sm text-neutral-900 bg-white focus:outline-none focus:ring-1 focus:ring-neutral-900 focus:border-neutral-900';
function textInput(f, value, extra = "", attrs = "") {
  return `<input data-f="${f}" value="${esc(value ?? "")}" class="${INPUT_CLS} ${extra}" ${attrs}>`;
}
function dateInput(f, value) {
  return `<input type="date" data-f="${f}" value="${esc(value ?? "")}" class="${INPUT_CLS}">`;
}
function selectInput(f, value, options, allowEmpty = false) {
  let opts = allowEmpty ? `<option value="">—</option>` : "";
  for (const o of options) opts += `<option value="${esc(o)}" ${o === value ? "selected" : ""}>${esc(o)}</option>`;
  return `<div class="relative"><select data-f="${f}" class="${INPUT_CLS} appearance-none pr-7">${opts}</select>
    <span class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-neutral-400">${icon("chevron", 13)}</span></div>`;
}
function rowInput(field2, value, cls, type = "text", ph = "") {
  return `<input data-field="${field2}" type="${type}" placeholder="${esc(ph)}" value="${esc(value ?? "")}" class="${INPUT_CLS} ${cls}">`;
}
function rowSelect(field2, value, options, cls) {
  let opts = "";
  for (const o of options) opts += `<option value="${esc(o)}" ${o === value ? "selected" : ""}>${esc(o)}</option>`;
  return `<div class="relative ${cls}"><select data-field="${field2}" class="${INPUT_CLS} appearance-none pr-7">${opts}</select></div>`;
}
function baseInput(row) { return `<input type="hidden" data-base value="${esc(JSON.stringify(row || {}))}">`; }

function toast(msg, kind = "ok") {
  const el = document.createElement("div");
  el.className = "fixed bottom-5 right-5 z-[100] bg-neutral-900 text-white text-sm px-4 py-2.5 rounded-sm shadow-lg flex items-center gap-2";
  el.innerHTML = icon(kind === "error" ? "alert" : "check", 14, kind === "error" ? "text-rose-400" : "text-emerald-400") + esc(msg);
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 2600);
}

/* Merge form values onto the original draft (preserves fields without inputs) */
function mergeForm(base, root) {
  const d = JSON.parse(JSON.stringify(base || {}));
  root.querySelectorAll("[data-f]").forEach((el) => { d[el.dataset.f] = el.type === "checkbox" ? el.checked : el.value; });
  root.querySelectorAll("[data-list]").forEach((container) => {
    d[container.dataset.list] = [...container.querySelectorAll(":scope > [data-row]")].map((rowEl) => {
      const baseEl = rowEl.querySelector("[data-base]");
      const o = baseEl ? JSON.parse(baseEl.value || "{}") : {};
      rowEl.querySelectorAll("[data-field]").forEach((inp) => { o[inp.dataset.field] = inp.type === "checkbox" ? inp.checked : inp.value; });
      return o;
    });
  });
  return d;
}

/* ============================== API ============================== */
async function api(path, opts = {}) {
  const headers = { "Content-Type": "application/json", ...(opts.headers || {}) };
  if (TOKEN) headers.Authorization = "Bearer " + TOKEN;
  const res = await fetch(API_BASE + path, { ...opts, headers });
  let body = {}; try { body = await res.json(); } catch (e) { /* non-json */ }
  if (!res.ok) { const err = new Error(body.error || ("Request failed (" + res.status + ")")); err.status = res.status; throw err; }
  return body;
}

/* ============================== LOGIN ============================== */
function renderLogin() {
  document.getElementById("app").innerHTML = `
  <div class="min-h-screen flex items-center justify-center bg-neutral-950">
    <div class="w-full max-w-sm px-6 mf-fade">
      <div class="text-center mb-8">
        <div class="text-3xl font-black tracking-tight text-white">OFFCOMFRT</div>
        <div class="text-[11px] font-semibold tracking-[0.15em] text-neutral-500 uppercase mt-1">Manufacture Studio</div>
      </div>
      <form id="loginForm" class="bg-neutral-900 border border-neutral-800 rounded-sm p-6 space-y-4">
        <label class="block">
          <span class="text-[10px] font-semibold tracking-wider uppercase text-neutral-500">Manufacturer Password</span>
          <input id="loginPw" type="password" autocomplete="current-password" required
            class="mt-1 w-full bg-neutral-950 border border-neutral-700 rounded-sm px-3 py-2 text-sm text-white focus:outline-none focus:border-neutral-400">
        </label>
        <div id="loginErr" class="text-xs text-rose-400 hidden"></div>
        <button type="submit" class="w-full bg-white text-neutral-950 text-sm font-bold py-2.5 rounded-sm hover:bg-neutral-200 transition-colors">Enter Studio</button>
      </form>
    </div>
  </div>`;
  document.getElementById("loginForm").onsubmit = async (e) => {
    e.preventDefault();
    const errEl = document.getElementById("loginErr");
    errEl.classList.add("hidden");
    try {
      const body = await api("/login", { method: "POST", body: JSON.stringify({ password: document.getElementById("loginPw").value }) });
      TOKEN = body.token;
      localStorage.setItem(TOKEN_KEY, TOKEN);
      await boot();
    } catch (err) {
      errEl.textContent = err.message;
      errEl.classList.remove("hidden");
    }
  };
}

/* ============================== SHELL ============================== */
const NAV = [
  { key: "dashboard", label: "Dashboard", icon: "dashboard" },
  { key: "samples", label: "My Samples", icon: "package" },
  { key: "orders", label: "My Orders", icon: "truck" },
  { key: "techpacks", label: "Tech Packs", icon: "files" }
];

function renderShell() {
  document.getElementById("app").innerHTML = `
  <div class="min-h-screen bg-stone-50 text-neutral-900">
    <div class="bg-neutral-900 text-white">
      <div class="max-w-[1400px] mx-auto px-6 pt-6 pb-4">
        <div class="flex items-baseline justify-between">
          <div>
            <div class="text-2xl font-black tracking-tight">OFFCOMFRT</div>
            <div class="text-[11px] font-semibold tracking-[0.15em] text-neutral-400 uppercase mt-0.5">Manufacture Studio · ${esc(WS.manufacturerName || "")}</div>
          </div>
          <button id="logoutBtn" class="text-[10px] font-semibold tracking-wider uppercase text-neutral-400 hover:text-white border border-neutral-700 hover:border-neutral-400 rounded-sm px-2 py-1">Sign out</button>
        </div>
      </div>
      <div class="max-w-[1400px] mx-auto px-6 flex gap-1" id="navBar"></div>
    </div>
    <main class="max-w-[1400px] mx-auto px-6 py-6" id="main"></main>
  </div>`;
  document.getElementById("logoutBtn").onclick = () => { localStorage.removeItem(TOKEN_KEY); TOKEN = null; WS = null; renderLogin(); };
  renderNav();
  renderMain();
}

function renderNav() {
  document.getElementById("navBar").innerHTML = NAV.map((n) =>
    `<button data-nav="${n.key}" class="flex items-center gap-1.5 px-3 py-2.5 text-xs font-semibold border-b-2 -mb-px transition-colors ${TAB === n.key ? "border-white text-white" : "border-transparent text-neutral-400 hover:text-neutral-200"}">${icon(n.icon, 13)} ${n.label}</button>`
  ).join("");
  document.querySelectorAll("[data-nav]").forEach((b) => b.onclick = () => { TAB = b.dataset.nav; renderNav(); renderMain(); });
}

function renderMain() {
  const main = document.getElementById("main");
  if (TAB === "dashboard") renderDashboard(main);
  if (TAB === "samples") renderSamples(main);
  if (TAB === "orders") renderOrders(main);
  if (TAB === "techpacks") renderTechPacks(main);
}

/* ============================== DASHBOARD ============================== */
function renderDashboard(main) {
  const samples = WS.samples || [];
  const orders = WS.productionOrders || [];

  const active = samples.filter((s) => s.stage !== "Closed");
  const overdue = active.filter((s) => statusLight(s) === "red");
  const dueSoon = active.filter((s) => { const d = daysRemaining(s); return d != null && d >= 0 && d <= 7; });
  const awaitingMfr = samples.filter((s) => s.waitingOn === "Manufacturer" && s.stage !== "Closed");

  const stageCounts = STAGE_OPTIONS.map((st) => ({ label: st, count: samples.filter((s) => s.stage === st).length }))
    .filter((s) => s.count > 0);
  const maxStage = Math.max(1, ...stageCounts.map((s) => s.count));

  const upcoming = active
    .filter((s) => daysRemaining(s) != null && daysRemaining(s) >= 0)
    .sort((a, b) => daysRemaining(a) - daysRemaining(b)).slice(0, 10);
  const overdueList = overdue.sort((a, b) => daysOverdue(b) - daysOverdue(a)).slice(0, 10);

  const prodActive = orders.filter((o) => o.currentStage !== "Delivered");

  main.innerHTML = `<div class="mf-fade">
  ${sectionHeading("—", "Your Workspace")}
  <div class="grid grid-cols-5 border border-neutral-200 rounded-sm bg-white divide-x divide-neutral-200">
    ${kpi("Active Samples", active.length)}
    ${kpi("Due Within 7 Days", dueSoon.length)}
    ${kpi("Overdue", overdue.length, overdue.length ? "text-rose-600" : "")}
    ${kpi("Waiting On You", awaitingMfr.length, awaitingMfr.length ? "text-amber-600" : "")}
    ${kpi("Orders In Production", prodActive.length)}
  </div>

  ${stageCounts.length ? `
  ${sectionHeading("A", "Sample Pipeline")}
  <div class="border border-neutral-200 rounded-sm bg-white p-4">${stageCounts.map((s) => bar(s.label, s.count, maxStage)).join("")}</div>` : ""}

  <div class="grid grid-cols-2 gap-6">
    <div>
      ${sectionHeading("B", "Upcoming Deadlines")}
      ${upcoming.length === 0 ? emptyState("clock", "Nothing due", "No open samples have an upcoming due date.") :
        `<div class="border border-neutral-200 rounded-sm bg-white overflow-hidden">${upcoming.map((s) =>
          `<button data-open-sample="${esc(s.id)}" class="w-full flex items-center gap-3 px-3 py-2 text-left border-b last:border-b-0 border-neutral-100 hover:bg-neutral-50">
            ${dot(statusLight(s))}
            <span class="font-mono text-[11px] text-neutral-500 w-32 truncate">${esc(s.id)}</span>
            <span class="text-xs text-neutral-800 flex-1 truncate">${esc(s.product)} · ${esc(s.version || "")}</span>
            <span class="text-xs font-mono text-neutral-700 w-16 text-right">${daysRemaining(s)}d</span>
          </button>`).join("")}</div>`}
    </div>
    <div>
      ${sectionHeading("C", "Overdue")}
      ${overdueList.length === 0 ? emptyState("check", "Nothing overdue", "Every open sample is within its due date.") :
        `<div class="border border-neutral-200 rounded-sm bg-white overflow-hidden">${overdueList.map((s) =>
          `<button data-open-sample="${esc(s.id)}" class="w-full flex items-center gap-3 px-3 py-2 text-left border-b last:border-b-0 border-neutral-100 hover:bg-rose-50/50">
            <span class="font-mono text-[11px] text-neutral-500 w-32 truncate">${esc(s.id)}</span>
            <span class="text-xs text-neutral-800 flex-1 truncate">${esc(s.product)}</span>
            <span class="text-xs font-mono text-rose-600 font-bold w-16 text-right">${daysOverdue(s)}d</span>
          </button>`).join("")}</div>`}
    </div>
  </div>

  ${sectionHeading("D", "Production Orders")}
  ${orders.length === 0 ? emptyState("truck", "No production orders yet", "Bulk orders assigned to you will appear here.") :
    `<div class="border border-neutral-200 rounded-sm bg-white overflow-hidden">
      ${orders.slice().sort((a, b) => LIGHT_ORDER[productionLight(a)] - LIGHT_ORDER[productionLight(b)]).map((o) =>
        `<button data-open-order="${esc(o.id)}" class="w-full flex items-center gap-4 px-4 py-2.5 text-left border-b last:border-b-0 border-neutral-100 hover:bg-neutral-50">
          ${dot(productionLight(o))}
          <span class="font-mono text-[11px] text-neutral-500 w-36 truncate">${esc(o.id)}</span>
          <span class="text-xs text-neutral-800 flex-1 truncate">${esc(o.product)} · ${orderQty(o).toLocaleString("en-IN")} pcs</span>
          <span class="text-xs text-neutral-600 w-40">${esc(o.currentStage || "")}</span>
          <span class="text-xs font-mono text-neutral-500 w-24 text-right">${fmtDate(o.expectedDelivery)}</span>
        </button>`).join("")}
    </div>`}
  </div>`;

