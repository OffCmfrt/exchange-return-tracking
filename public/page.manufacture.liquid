/* ============================== DRAWER SHARED BITS ============================== */
function drawerTabBtn(tab, iconName, label, count) {
  return `<button data-tab="${tab}" class="flex items-center gap-1.5 px-3 py-2 text-xs font-medium border-b-2 -mb-px whitespace-nowrap border-transparent text-neutral-400 hover:text-neutral-600">
    ${icon(iconName, 13)} ${label}${count != null && count > 0 ? `<span class="ml-0.5 text-[10px] text-neutral-400">(${count})</span>` : ""}</button>`;
}
function setDrawerTab(overlay, tab) {
  overlay.querySelectorAll("[data-tab]").forEach((b) => {
    const on = b.dataset.tab === tab;
    b.className = `flex items-center gap-1.5 px-3 py-2 text-xs font-medium border-b-2 -mb-px whitespace-nowrap ${on ? "border-neutral-900 text-neutral-900" : "border-transparent text-neutral-400 hover:text-neutral-600"}`;
  });
  overlay.querySelectorAll("[data-pane]").forEach((p) => p.classList.toggle("hidden", p.dataset.pane !== tab));
}
function updateQcBadges(listEl) {
  listEl.querySelectorAll(":scope > [data-row]").forEach((row) => {
    const get = (f) => { const i = row.querySelector(`[data-field="${f}"]`); return i ? i.value : ""; };
    const spec = get("spec"), tol = get("tolerance"), act = get("actual");
    const badge = row.querySelector("[data-pass]");
    if (!badge) return;
    if (spec === "" || spec == null || tol === "" || tol == null || act === "") { badge.innerHTML = '<span class="text-[10px] text-neutral-400">manual</span>'; return; }
    const pass = Math.abs(Number(act) - Number(spec)) <= Number(tol);
    badge.innerHTML = pass ? '<span class="text-[11px] font-semibold text-emerald-600">Pass</span>' : '<span class="text-[11px] font-semibold text-rose-600">Fail</span>';
  });
}
function commRowHtml(c) {
  return `<div data-row class="border border-neutral-200 rounded-sm p-3 space-y-2">
    <div class="flex justify-between gap-2">
      <div class="grid grid-cols-4 gap-2 flex-1">
        ${rowInput("date", c.date || "", "", "date")}
        ${rowInput("from", c.from, "", "text", "From")}
        ${rowInput("to", c.to, "", "text", "To")}
        ${rowSelect("status", c.status || "Open", COMM_STATUS_OPTIONS, "")}
      </div>
    </div>
    ${rowInput("message", c.message, "w-full", "text", "Message / question")}
    ${rowInput("response", c.response, "w-full", "text", "Response")}
    ${rowInput("decision", c.decision, "w-full", "text", "Decision / agreement")}
    ${baseInput(c)}
  </div>`;
}
function fileRowHtml(f, typeOptions) {
  return `<div data-row class="border border-neutral-200 rounded-sm p-3 grid grid-cols-12 gap-2 items-center">
    <div class="col-span-3">${rowSelect("type", f.type || typeOptions[0], typeOptions, "")}</div>
    ${rowInput("description", f.description, "col-span-3", "text", "Description")}
    ${rowInput("link", f.link, "col-span-4", "text", "Google Drive link")}
    ${rowInput("date", f.date || "", "col-span-1", "date")}
    ${baseInput(f)}
  </div>`;
}
function wireAdds(overlay, templates) {
  overlay.addEventListener("click", (e) => {
    const add = e.target.closest("[data-add]");
    if (add) {
      const key = add.dataset.add;
      overlay.querySelector(`[data-list="${key}"]`).insertAdjacentHTML("beforeend", templates[key]());
    }
  });
}

/* ============================== SAMPLE DRAWER (MFR) ============================== */
function openSampleDrawer(initial) {
  const base = JSON.parse(JSON.stringify(initial));
  const overlay = document.createElement("div");
  overlay.className = "fixed inset-0 z-[80] bg-black/40 flex justify-end";

  const qcRows = (base.qc || []).map((row) => `
    <div data-row class="border border-neutral-200 rounded-sm p-3 grid grid-cols-12 gap-2 items-center">
      <div class="col-span-3 text-sm text-neutral-800 px-1 truncate" title="${esc(row.point)}">${esc(row.point || "—")}</div>
      <div class="col-span-2 text-xs font-mono text-neutral-500 text-center">${row.spec ?? "—"} ±${row.tolerance ?? "—"}</div>
      ${rowInput("actual", row.actual ?? "", "col-span-2", "number", "Actual")}
      <div class="col-span-2 flex justify-center" data-pass></div>
      ${rowInput("mfrComment", row.mfrComment, "col-span-3", "text", "Your comment")}
      ${baseInput(row)}
    </div>`).join("");

  const revRows = (base.revisions || []).map((r) => `
    <div data-row class="border border-neutral-200 rounded-sm p-3 space-y-2">
      <div class="grid grid-cols-4 gap-2 text-xs text-neutral-500">
        <div><span class="font-semibold text-neutral-700">${esc(r.prevVersion || "—")} → ${esc(r.newVersion || "—")}</span></div>
        <div class="font-mono">${fmtDate(r.date)}</div>
        <div class="col-span-2">${rowSelect("status", r.status || "Not Started", REVISION_STATUS_OPTIONS, "max-w-[180px] ml-auto")}</div>
      </div>
      <div class="text-xs text-neutral-600"><span class="font-semibold uppercase text-neutral-400">Issue:</span> ${esc(r.issue || "—")}</div>
      <div class="text-xs text-neutral-600"><span class="font-semibold uppercase text-neutral-400">Change required:</span> ${esc(r.changeRequired || "—")}</div>
      ${rowInput("mfrResponse", r.mfrResponse, "w-full", "text", "Your response")}
      ${baseInput(r)}
    </div>`).join("");

  overlay.innerHTML = `
  <div class="bg-white w-full max-w-3xl h-full flex flex-col shadow-2xl mf-fade">
    <div class="flex items-center justify-between px-5 py-4 border-b border-neutral-200">
      <div>
        <div class="text-[10px] font-semibold tracking-wider uppercase text-neutral-400">Sample</div>
        <div class="font-mono text-sm text-neutral-900">${esc(base.id)}</div>
      </div>
      <div class="flex items-center gap-2">
        ${statusPill(statusLight(base))}
        <button data-close class="p-1.5 text-neutral-400 hover:text-neutral-700">${icon("x", 18)}</button>
      </div>
    </div>

    <div class="flex px-5 border-b border-neutral-200 shrink-0 overflow-x-auto">
      ${drawerTabBtn("overview", "clipboard", "Overview")}
      ${drawerTabBtn("qc", "ruler", "Measurements", base.qc.length)}
      ${drawerTabBtn("revisions", "files", "Revisions", base.revisions.length)}
      ${drawerTabBtn("comms", "message", "Communication", base.comms.length)}
      ${drawerTabBtn("files", "paperclip", "Files", base.files.length)}
    </div>

    <div class="flex-1 overflow-y-auto px-5 py-5" data-form>
      <div data-pane="overview" class="space-y-6">
        <div class="grid grid-cols-3 gap-3">
          ${readField("Product Name", base.product, true)}
          ${readField("Category", base.category)}
          ${readField("SKU", base.sku)}
          ${readField("Version", base.version)}
          ${readField("Sample Type", base.type)}
          ${readField("Fabric / Material", base.fabric, true)}
          ${readField("GSM", base.gsm)}
          ${readField("Composition", base.composition)}
          ${readField("Color", base.color)}
          ${readField("Size", base.size)}
          ${readField("Fit", base.fit)}
          ${readField("Request Date", fmtDate(base.requestDate))}
          ${readField("Tech Pack", base.techPackId)}
          ${base.refLink ? readField("Reference Link", base.refLink) : ""}
        </div>

        <div class="grid grid-cols-2 gap-3 pt-4 border-t border-neutral-100">
          ${field("Current Status", selectInput("status", base.status, STATUS_OPTIONS))}
          ${field("Current Stage", selectInput("stage", base.stage, STAGE_OPTIONS))}
          ${field("Target Date", dateInput("targetDate", base.targetDate))}
          ${field("Next Action Due", dateInput("nextDue", base.nextDue))}
          ${field("Courier / AWB", textInput("courierAwb", base.courierAwb))}
          <div class="grid grid-cols-2 gap-3">
            ${field("Date Sent", dateInput("dateSent", base.dateSent))}
            ${field("Date Received", dateInput("dateReceived", base.dateReceived))}
          </div>
        </div>

        <div class="grid grid-cols-1 gap-3 pt-4 border-t border-neutral-100">
          ${field("Your Update", `<textarea data-f="mfrUpdate" class="${INPUT_CLS} min-h-[52px] resize-y">${esc(base.mfrUpdate || "")}</textarea>`)}
          ${readField("Offcomfrt Feedback", base.feedback)}
          ${field("Changes Required / Acknowledged", `<textarea data-f="changesRequired" class="${INPUT_CLS} min-h-[52px] resize-y">${esc(base.changesRequired || "")}</textarea>`)}
          ${readField("Next Action (Offcomfrt)", base.nextAction)}
          ${readField("Action Owner", base.actionOwner)}
        </div>

        <div class="grid grid-cols-3 gap-3 pt-4 border-t border-neutral-100">
          ${readField("Approval Status", base.approvalStatus)}
          ${readField("Approved By", base.approvedBy)}
          ${readField("Approval Date", fmtDate(base.approvalDate))}
          ${readField("Final Decision", base.finalDecision, true)}
          ${readField("Notes", base.notes, true)}
        </div>
      </div>

      <div data-pane="qc" class="hidden">
        <div class="text-xs text-neutral-400 mb-3">Enter your actual measurements — Pass / Fail is calculated automatically against the spec.</div>
        <div class="space-y-2" data-list="qc">${qcRows || emptyState("ruler", "No measurement points", "Offcomfrt will add measurement points to this sample.")}</div>
      </div>

      <div data-pane="revisions" class="hidden">
        <div class="space-y-3" data-list="revisions">${revRows || emptyState("files", "No revisions", "Revision requests from Offcomfrt will appear here.")}</div>
      </div>

      <div data-pane="comms" class="hidden">
        <div class="space-y-3" data-list="comms">${base.comms.map(commRowHtml).join("")}</div>
        <button data-add="comms" class="mt-3 flex items-center gap-1.5 text-xs font-semibold text-neutral-700 hover:text-neutral-900">${icon("plus", 14)} Log a message</button>
      </div>

      <div data-pane="files" class="hidden">
        <div class="space-y-2" data-list="files">${base.files.map((f) => fileRowHtml(f, FILE_TYPE_OPTIONS)).join("")}</div>
        <button data-add="files" class="mt-3 flex items-center gap-1.5 text-xs font-semibold text-neutral-700 hover:text-neutral-900">${icon("plus", 14)} Attach a file link</button>
      </div>
    </div>

    <div class="flex items-center justify-between px-5 py-4 border-t border-neutral-200 shrink-0">
      <div class="text-xs text-rose-500" data-err></div>
      <div class="flex gap-2">
        <button data-close class="px-4 py-2 text-sm rounded-sm border border-neutral-300 hover:bg-neutral-50">Cancel</button>
        <button data-save class="px-4 py-2 text-sm rounded-sm bg-neutral-900 text-white hover:bg-neutral-800">Save Changes</button>
      </div>
    </div>
  </div>`;
  document.body.appendChild(overlay);

  wireAdds(overlay, {
    comms: () => commRowHtml({ id: uid("COM"), date: todayISO(), from: WS.manufacturerName, to: "Offcomfrt", message: "", response: "", decision: "", actionOwner: "", dueDate: "", status: "Open" }),
    files: () => fileRowHtml({ id: uid("FL"), type: "Front Photo", description: "", link: "", uploadedBy: WS.manufacturerName, date: todayISO() }, FILE_TYPE_OPTIONS)
  });

  const form = overlay.querySelector("[data-form]");
  overlay.querySelectorAll("[data-tab]").forEach((b) => b.onclick = () => setDrawerTab(overlay, b.dataset.tab));
  overlay.querySelectorAll("[data-close]").forEach((b) => b.onclick = () => overlay.remove());
  updateQcBadges(form.querySelector('[data-list="qc"]'));
  form.addEventListener("input", (e) => {
    const qcList = e.target.closest('[data-list="qc"]');
    if (qcList) updateQcBadges(qcList);
  });

  overlay.querySelector("[data-save]").onclick = async () => {
    const draft = mergeForm(base, form);
    const errEl = overlay.querySelector("[data-err]");
    // Only whitelisted fields are sent — the server enforces this too
    const patch = {
      status: draft.status, stage: draft.stage, targetDate: draft.targetDate, nextDue: draft.nextDue,
      courierAwb: draft.courierAwb, dateSent: draft.dateSent, dateReceived: draft.dateReceived,
      mfrUpdate: draft.mfrUpdate, changesRequired: draft.changesRequired,
      qc: draft.qc, comms: draft.comms, files: draft.files, revisions: draft.revisions
    };
    try {
      const body = await api("/samples/" + encodeURIComponent(base.id), { method: "PUT", body: JSON.stringify(patch) });
      const i = WS.samples.findIndex((s) => s.id === base.id);
      if (i >= 0) WS.samples[i] = body.record;
      toast("Sample updated");
      overlay.remove();
      renderMain();
    } catch (err) { errEl.textContent = err.message; }
  };
  setDrawerTab(overlay, "overview");
}

