            ${baseInput(row)}
          </div>`).join("")}</div>
        <button data-add="qc" class="mt-3 flex items-center gap-1.5 text-xs font-semibold text-neutral-700 hover:text-neutral-900">${icon("plus", 14)} Log an inspection</button>
      </div>

      <div data-pane="comms" class="hidden">
        <div class="space-y-3" data-list="comms">${base.comms.map(commRowHtml).join("")}</div>
        <button data-add="comms" class="flex items-center gap-1.5 text-xs font-semibold text-neutral-700 hover:text-neutral-900">${icon("plus", 14)} Log a message</button>
      </div>

      <div data-pane="files" class="hidden">
        <div class="space-y-2" data-list="files">${base.files.map((f) => fileRowHtml(f, PROD_FILE_TYPE_OPTIONS)).join("")}</div>
        <button data-add="files" class="flex items-center gap-1.5 text-xs font-semibold text-neutral-700 hover:text-neutral-900">${icon("plus", 14)} Attach a file link</button>
      </div>
    </div>

    <div class="flex items-center justify-between px-5 py-4 border-t border-neutral-200 shrink-0">
      <div class="text-xs text-rose-500" data-err></div>
      <div class="flex gap-2">
        <button data-close class="px-4 py-2 text-sm rounded-sm border border-neutral-300 hover:bg-neutral-50">Cancel</button>
        <button data-save class="px-4 py-2 text-sm rounded-sm bg-neutral-900 text-white hover:bg-neutral-800">Save Changes</button>
      </div>
    </div>
  </div>`;
  document.body.appendChild(overlay);

  wireAdds(overlay, {
    qc: () => `<div data-row class="border border-neutral-200 rounded-sm p-3 space-y-2">
      <div class="grid grid-cols-4 gap-2">
        ${rowSelect("checkpoint", "Inline Inspection", PROD_QC_CHECKPOINTS, "")}
        ${rowInput("date", todayISO(), "", "date")}
        ${rowInput("inspector", "", "", "text", "Inspector")}
        ${rowSelect("result", "Pending", PROD_QC_RESULT_OPTIONS, "")}
      </div>
      <div class="flex gap-2 items-start">
        ${rowInput("defectRate", "", "w-32", "number", "Defect %")}
        ${rowInput("comments", "", "flex-1", "text", "Comments")}
      </div>
      ${baseInput({})}
    </div>`,
    comms: () => commRowHtml({ id: uid("COM"), date: todayISO(), from: WS.manufacturerName, to: "Offcomfrt", message: "", response: "", decision: "", actionOwner: "", dueDate: "", status: "Open" }),
    files: () => fileRowHtml({ id: uid("FL"), type: "Photo", description: "", link: "", uploadedBy: WS.manufacturerName, date: todayISO() }, PROD_FILE_TYPE_OPTIONS)
  });

  const form = overlay.querySelector("[data-form]");
  overlay.querySelectorAll("[data-tab]").forEach((b) => b.onclick = () => setDrawerTab(overlay, b.dataset.tab));
  overlay.querySelectorAll("[data-close]").forEach((b) => b.onclick = () => overlay.remove());
  form.addEventListener("change", (e) => {
    if (e.target.dataset.f === "currentStage") overlay.querySelector("[data-stepper]").innerHTML = stageStepper(e.target.value);
  });

  overlay.querySelector("[data-save]").onclick = async () => {
    const draft = mergeForm(base, form);
    const errEl = overlay.querySelector("[data-err]");
    const patch = {
      currentStage: draft.currentStage, trackingNumber: draft.trackingNumber,
      shippingMethod: draft.shippingMethod, actualDelivery: draft.actualDelivery,
      qc: draft.qc, comms: draft.comms, files: draft.files
    };
    try {
      const body = await api("/orders/" + encodeURIComponent(base.id), { method: "PUT", body: JSON.stringify(patch) });
      const i = WS.productionOrders.findIndex((o) => o.id === base.id);
      if (i >= 0) WS.productionOrders[i] = body.record;
      toast("Order updated");
      overlay.remove();
      renderMain();
    } catch (err) { errEl.textContent = err.message; }
  };
  setDrawerTab(overlay, "overview");
}

/* ============================== TECH PACK QUESTIONS MODAL ============================== */
function openQuestionsModal(tp) {
  const overlay = document.createElement("div");
  overlay.className = "fixed inset-0 z-[80] bg-black/40 flex items-center justify-center p-4";
  overlay.innerHTML = `
  <div class="bg-white w-full max-w-lg rounded-sm border border-neutral-200 mf-fade">
    <div class="flex items-center justify-between px-5 py-4 border-b border-neutral-200">
      <div>
        <div class="text-sm font-semibold">Questions for ${esc(tp.id)}</div>
        <div class="text-[11px] text-neutral-400">${esc(tp.product || "")} · ${esc(tp.status || "")}</div>
      </div>
      <button data-close class="text-neutral-400 hover:text-neutral-700">${icon("x", 18)}</button>
    </div>
    <div class="p-5">
      ${tp.link ? `<a href="${esc(tp.link)}" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-700 border border-neutral-300 rounded-sm px-2.5 py-1.5 hover:bg-neutral-50 mb-3">${icon("paperclip", 13)} Open tech pack</a>` : ""}
      <label class="flex flex-col gap-1">
        <span class="text-[10px] font-semibold tracking-wider uppercase text-neutral-400">Your Questions</span>
        <textarea id="tpQuestions" class="${INPUT_CLS} min-h-[120px] resize-y">${esc(tp.manufacturerQuestions || "")}</textarea>
      </label>
    </div>
    <div class="flex items-center justify-between px-5 py-4 border-t border-neutral-200">
      <div class="text-xs text-rose-500" data-err></div>
      <div class="flex gap-2">
        <button data-close class="px-4 py-2 text-sm rounded-sm border border-neutral-300 hover:bg-neutral-50">Cancel</button>
        <button data-save class="px-4 py-2 text-sm rounded-sm bg-neutral-900 text-white hover:bg-neutral-800">Save Questions</button>
      </div>
    </div>
  </div>`;
  document.body.appendChild(overlay);
  overlay.querySelectorAll("[data-close]").forEach((b) => b.onclick = () => overlay.remove());
  overlay.querySelector("[data-save]").onclick = async () => {
    try {
      const body = await api("/techpacks/" + encodeURIComponent(tp.id), {
        method: "PUT",
        body: JSON.stringify({ manufacturerQuestions: document.getElementById("tpQuestions").value })
      });
      const i = WS.techPacks.findIndex((t) => t.id === tp.id);
      if (i >= 0) WS.techPacks[i] = body.record;
      toast("Questions saved");
      overlay.remove();
      renderMain();
    } catch (err) { overlay.querySelector("[data-err]").textContent = err.message; }
  };
}

/* ============================== BOOT ============================== */
async function boot() {
  try {
    const body = await api("/workspace");
    WS = body.workspace;
    WS.samples = WS.samples || []; WS.productionOrders = WS.productionOrders || [];
    WS.techPacks = WS.techPacks || [];
    renderShell();
  } catch (err) {
    if (err.status === 401 || err.status === 503) { TOKEN = null; localStorage.removeItem(TOKEN_KEY); renderLogin(); }
    else {
      document.getElementById("app").innerHTML = `<div class="min-h-screen flex items-center justify-center"><div class="text-sm text-neutral-500">${esc(err.message)}</div></div>`;
    }
  }
}
if (TOKEN) boot(); else renderLogin();
</script>
</body>
</html>
