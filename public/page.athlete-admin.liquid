      <div class="ah-detail-row"><span class="label">Athlete No</span><span class="value">${a.athlete_no||'—'}</span></div>
      <div class="ah-detail-row"><span class="label">Status</span><span class="value">${statusBadge(a.athlete_status)}</span></div>
      <div class="ah-detail-row"><span class="label">Phone</span><span class="value">${a.phone||'—'}</span></div>
      <div class="ah-detail-row"><span class="label">Email</span><span class="value">${a.email||'—'}</span></div>
      <div class="ah-detail-row"><span class="label">Joined</span><span class="value">${a.joined_at ? new Date(a.joined_at).toLocaleDateString('en-IN') : '—'}</span></div>
    </div>
    <div class="ah-drawer-section">
      <h4>Level & XP</h4>
      <div class="ah-detail-row"><span class="label">Current Level</span><span class="value">${levelBadge(a)}</span></div>
      <div class="ah-detail-row"><span class="label">XP Total</span><span class="value">${(a.xp_total||0).toLocaleString()}</span></div>
      <div class="ah-detail-row"><span class="label">Standing</span><span class="value">${parseFloat(a.standing_score||0).toFixed(1)}</span></div>
      <div class="ah-detail-row"><span class="label">Coin Balance</span><span class="value">${(a.coin_balance||0).toLocaleString()}</span></div>
      <div class="ah-detail-row"><span class="label">Level Since</span><span class="value">${a.level_since ? new Date(a.level_since).toLocaleDateString('en-IN') : '—'}</span></div>
    </div>
    <div class="ah-drawer-section">
      <h4>Portal Access</h4>
      <div id="tokenSection-${a.id}">
        <div style="font-size:.7rem;color:var(--muted);margin-bottom:.75rem;line-height:1.5">
          Share the portal link and access token with this athlete so they can view their progress, tasks, and leaderboard.
        </div>
        <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="generateToken(${a.id})" style="width:100%">Generate Portal Token</button>
        <div id="tokenResult-${a.id}" style="margin-top:.75rem"></div>
      </div>
    </div>
    <div class="ah-drawer-section">
      <h4>Actions</h4>
      <div style="display:flex;gap:.5rem;flex-wrap:wrap">
        <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="overrideLevel(${a.id})">Override Level</button>
        <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="changeStatus(${a.id},'SUSPENDED')">Suspend</button>
        <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="changeStatus(${a.id},'ACTIVE')">Activate</button>
        <button class="ah-btn ah-btn-sm ah-btn-danger" onclick="changeStatus(${a.id},'DISCHARGED')">Discharge</button>
      </div>
    </div>`;
  document.getElementById('drawerOverlay').classList.add('active');
  document.getElementById('drawer').classList.add('active');
}

function closeDrawer() {
  document.getElementById('drawerOverlay').classList.remove('active');
  document.getElementById('drawer').classList.remove('active');
}

// ── HELPERS ──
function levelBadge(a) {
  const name = a.level_name || a.level?.display_name || '—';
  const ord = a.level_ordinal || a.level?.ordinal || 0;
  const segs = a.level_dial || a.level?.dial_segments_lit || 0;
  let dots = '';
  for (let i = 0; i < 5; i++) dots += `<span class="dot${i < segs ? ' lit' : ''}"></span>`;
  return `<span class="ah-badge-level"><span class="dots">${dots}</span>${name}</span>`;
}

function statusBadge(s) {
  const cls = (s||'').toLowerCase().replace(/_/g,'-');
  return `<span class="ah-badge ${cls}">${(s||'').replace(/_/g,' ')}</span>`;
}

function standingMini(score) {
  const s = parseFloat(score) || 0;
  const circ = 79.17; // 2*pi*12.6
  const offset = circ - (s / 100) * circ;
  return `<div class="ah-standing-mini">
    <div class="ring"><svg viewBox="0 0 28 28"><circle class="track" cx="14" cy="14" r="12.6"/>
    <circle class="fill" cx="14" cy="14" r="12.6" stroke-dasharray="${circ}" stroke-dashoffset="${offset}"/></svg></div>
    <span class="val">${s.toFixed(0)}</span></div>`;
}

function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

// ── ACTIONS ──
async function approveApp(id) {
  await fetch(`${API}/applications/${id}/approve`, { method: 'POST', headers: { 'Authorization': 'Bearer ' + adminToken } });
  await refreshData();
}
async function rejectApp(id) {
  const reason = prompt('Rejection reason:');
  if (!reason) return;
  await fetch(`${API}/applications/${id}/reject`, { method: 'POST', headers: { 'Authorization': 'Bearer ' + adminToken, 'Content-Type': 'application/json' }, body: JSON.stringify({ reason }) });
  await refreshData();
}
async function reviewAssignment(id, action) {
  const statusMap = { approve: 'APPROVED', changes: 'CHANGES_REQUESTED', reject: 'REJECTED' };
  await fetch(`${API}/assignments/${id}/review`, { method: 'PATCH', headers: { 'Authorization': 'Bearer ' + adminToken, 'Content-Type': 'application/json' }, body: JSON.stringify({ status: statusMap[action] }) });
  await refreshData();
}
async function changeStatus(id, status) {
  await fetch(`${API}/athletes/${id}/status`, { method: 'PATCH', headers: { 'Authorization': 'Bearer ' + adminToken, 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) });
  await refreshData();
  closeDrawer();
}
async function overrideLevel(id) {
  const lvlId = prompt('Level ID to override to:');
  const reason = prompt('Reason (mandatory):');
  if (!lvlId || !reason) return;
  await fetch(`${API}/athletes/${id}/override-level`, { method: 'POST', headers: { 'Authorization': 'Bearer ' + adminToken, 'Content-Type': 'application/json' }, body: JSON.stringify({ level_id: parseInt(lvlId), reason }) });
  await refreshData();
  closeDrawer();
}
async function buildPayoutBatch() {
  const start = prompt('Period start (YYYY-MM-DD):');
  const end = prompt('Period end (YYYY-MM-DD):');
  if (!start || !end) return;
  await fetch(`${API}/payouts/build-batch`, { method: 'POST', headers: { 'Authorization': 'Bearer ' + adminToken, 'Content-Type': 'application/json' }, body: JSON.stringify({ period_start: start, period_end: end }) });
  await refreshData();
}
async function queuePayout(id) {
  await fetch(`${API}/payouts/${id}/queue`, { method: 'POST', headers: { 'Authorization': 'Bearer ' + adminToken } });
  await refreshData();
}
async function saveSettings() {
  const inputs = document.querySelectorAll('.setting-input');
  const updates = [];
  inputs.forEach(inp => {
    try { updates.push({ key: inp.dataset.key, value: JSON.parse(inp.value) }); } catch(e) {}
  });
  await fetch(API + '/settings', { method: 'PATCH', headers: { 'Authorization': 'Bearer ' + adminToken, 'Content-Type': 'application/json' }, body: JSON.stringify({ settings: updates }) });
  alert('Settings saved');
  await refreshData();
}

async function generateToken(athleteId, rotate = false) {
  const resultDiv = document.getElementById(`tokenResult-${athleteId}`);
  if (!resultDiv) return;
  
  resultDiv.innerHTML = '<div style="font-size:.7rem;color:var(--muted)">Generating...</div>';
  
  try {
    const res = await fetch(`${API}/athletes/${athleteId}/token`, {
      method: 'POST',
      headers: { 
        'Authorization': 'Bearer ' + adminToken,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ rotate })
    });
    
    const data = await res.json();
    
    if (!data.success) {
      resultDiv.innerHTML = `<div style="font-size:.7rem;color:var(--danger)">Error: ${data.error || 'Failed to generate token'}</div>`;
      return;
    }
    
    if (data.data.access_token) {
      // New token generated - show it
      const portalUrl = data.data.portal_url;
      const token = data.data.access_token;
      
      resultDiv.innerHTML = `
        <div style="background:var(--surface-2);border:1px solid var(--border);padding:1rem;font-size:.7rem">
          <div style="color:var(--success);font-weight:600;margin-bottom:.5rem">✓ Token Generated</div>
          <div style="margin-bottom:.75rem">
            <div style="color:var(--muted);font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.25rem">Portal URL</div>
            <div style="word-break:break-all;color:var(--text);font-family:var(--mono)">${portalUrl}</div>
          </div>
          <div style="margin-bottom:.75rem">
            <div style="color:var(--muted);font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.25rem">Access Token</div>
            <div style="word-break:break-all;color:var(--text);font-family:var(--mono);background:var(--bg);padding:.5rem;border:1px solid var(--border)">${token}</div>
          </div>
          <div style="display:flex;gap:.5rem;margin-top:.75rem">
            <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="copyToken('${token}')" style="flex:1">Copy Token</button>
            <button class="ah-btn ah-btn-sm ah-btn-danger" onclick="generateToken(${athleteId}, true)" style="flex:1">Rotate</button>
          </div>
          <div style="color:var(--warning);font-size:.6rem;margin-top:.5rem;line-height:1.4">
            ⚠️ Save this token now — it won't be shown again. Use "Rotate" if the athlete loses it.
          </div>
        </div>`;
    } else {
      // Token already exists
      resultDiv.innerHTML = `
        <div style="background:var(--surface-2);border:1px solid var(--border);padding:1rem;font-size:.7rem">
          <div style="color:var(--info);font-weight:600;margin-bottom:.5rem">ℹ️ Token Already Exists</div>
          <div style="color:var(--muted);margin-bottom:.75rem;line-height:1.5">
            This athlete already has a portal token. If they lost it, click "Rotate" to generate a new one (the old token will stop working).
          </div>
          <button class="ah-btn ah-btn-sm ah-btn-danger" onclick="generateToken(${athleteId}, true)" style="width:100%">Rotate Token</button>
        </div>`;
    }
  } catch (err) {
    resultDiv.innerHTML = `<div style="font-size:.7rem;color:var(--danger)">Error: ${err.message}</div>`;
  }
}

function copyToken(token) {
  navigator.clipboard.writeText(token).then(() => {
    alert('Token copied to clipboard!');
  }).catch(() => {
    // Fallback for older browsers
    const textArea = document.createElement('textarea');
    textArea.value = token;
    document.body.appendChild(textArea);
    textArea.select();
    document.execCommand('copy');
    document.body.removeChild(textArea);
    alert('Token copied to clipboard!');
  });
}

// ── MODAL OVERLAY CLICK & KEYBOARD ──
document.getElementById('taskModalOverlay')?.addEventListener('click', e => { if (e.target === e.currentTarget) closeTaskModal(); });
document.getElementById('assignModalOverlay')?.addEventListener('click', e => { if (e.target === e.currentTarget) closeAssignModal(); });
document.getElementById('deleteModalOverlay')?.addEventListener('click', e => { if (e.target === e.currentTarget) closeDeleteModal(); });
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { closeTaskModal(); closeAssignModal(); closeDeleteModal(); }
});
</script>
</body>
</html>
