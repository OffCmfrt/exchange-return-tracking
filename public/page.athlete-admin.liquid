<!-- TOAST CONTAINER -->
<div id="toastContainer"></div>

<script>
const API = 'https://exchange-return-tracking.onrender.com/api/athlete-admin';
let adminToken = null;
let athletes = [], applications = [], tasks = [], reviewItems = [], levels = [], settings = [], payouts = [];

// ── INIT ──
document.addEventListener('DOMContentLoaded', () => {
  const saved = sessionStorage.getItem('ah_token');
  if (saved) { adminToken = saved; initShell(); }
  else { showAuthScreen(); }
  setupNav();
  setupAuthForm();
});

function showAuthScreen() {
  document.getElementById('loading').classList.add('out');
  document.getElementById('auth').style.display = 'flex';
}

function setupAuthForm() {
  document.getElementById('authForm').addEventListener('submit', async e => {
    e.preventDefault();
    adminToken = document.getElementById('authToken').value.trim();
    sessionStorage.setItem('ah_token', adminToken);
    initShell();
  });
}

async function initShell() {
  try {
    await loadAll();
    document.getElementById('auth').style.display = 'none';
    document.getElementById('loading').classList.add('out');
    document.getElementById('shell').classList.add('active');
    renderAll();
  } catch (err) {
    sessionStorage.removeItem('ah_token');
    document.getElementById('authErr').textContent = 'Authentication failed';
    showAuthScreen();
  }
}

async function loadAll() {
  const headers = { 'Authorization': 'Bearer ' + adminToken };
  const [athRes, appRes, taskRes, revRes, lvlRes, setRes, payRes] = await Promise.allSettled([
    fetch(API + '/athletes', { headers }).then(r => r.json()),
    fetch(API + '/applications', { headers }).then(r => r.json()),
    fetch(API + '/tasks', { headers }).then(r => r.json()),
    fetch(API + '/review-queue', { headers }).then(r => r.json()),
    fetch(API + '/levels', { headers }).then(r => r.json()),
    fetch(API + '/settings', { headers }).then(r => r.json()),
    fetch(API + '/payouts', { headers }).then(r => r.json())
  ]);
  athletes = athRes.value?.data || [];
  applications = appRes.value?.data || [];
  tasks = taskRes.value?.data || [];
  reviewItems = revRes.value?.data || [];
  levels = lvlRes.value?.data || [];
  settings = setRes.value?.data || [];
  payouts = payRes.value?.data || [];
}

function renderAll() {
  renderDashboard();
  renderAthletes();
  renderApplications();
  renderTasks();
  renderReview();
  renderLadder();
  renderSettings();
  renderPayouts();
  // Nav counts
  document.getElementById('navAthleteCount').textContent = athletes.length;
  document.getElementById('navAppCount').textContent = applications.filter(a => a.status === 'APPLIED').length;
  document.getElementById('navReviewCount').textContent = reviewItems.length;
}

async function refreshData() { await loadAll(); renderAll(); }

// ── NAV ──
function setupNav() {
  document.querySelectorAll('.ah-nav-item').forEach(item => {
    item.addEventListener('click', () => {
      document.querySelectorAll('.ah-nav-item').forEach(i => i.classList.remove('active'));
      document.querySelectorAll('.ah-section').forEach(s => s.classList.remove('active'));
      item.classList.add('active');
      const sec = item.dataset.section;
      document.getElementById('sec-' + sec).classList.add('active');
      document.getElementById('topbarTitle').textContent = item.textContent.trim().split('\n')[0];
    });
  });
}

// ── DASHBOARD ──
function renderDashboard() {
  document.getElementById('statTotal').textContent = athletes.length;
  document.getElementById('statActive').textContent = athletes.filter(a => a.athlete_status === 'ACTIVE').length + ' active';
  document.getElementById('statTrial').textContent = athletes.filter(a => a.athlete_status === 'ON_TRIAL').length;
  document.getElementById('statApps').textContent = applications.filter(a => a.status === 'APPLIED').length;
  document.getElementById('statReview').textContent = reviewItems.length;

  const tbody = document.getElementById('dashRecentAthletes');
  tbody.innerHTML = athletes.slice(0, 8).map(a => `<tr onclick="openAthleteDrawer(${a.id})" style="cursor:pointer">
    <td><strong>${esc(a.name)}</strong><div class="muted mono" style="font-size:.6rem;margin-top:2px">${a.athlete_no || '—'}</div></td>
    <td>${levelBadge(a)}</td>
    <td class="mono">${(a.xp_total||0).toLocaleString()}</td>
    <td>${standingMini(a.standing_score)}</td>
    <td>${statusBadge(a.athlete_status)}</td>
    <td class="muted">${a.joined_at ? new Date(a.joined_at).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) : '—'}</td>
  </tr>`).join('');
}

// ── ATHLETES ──
function renderAthletes() {
  const search = (document.getElementById('athleteSearch')?.value || '').toLowerCase();
  const filter = document.getElementById('athleteFilter')?.value || '';
  let list = athletes;
  if (search) list = list.filter(a => (a.name||'').toLowerCase().includes(search) || (a.athlete_no||'').toLowerCase().includes(search));
  if (filter) list = list.filter(a => a.athlete_status === filter);

  document.getElementById('athletesTable').innerHTML = list.map(a => `<tr onclick="openAthleteDrawer(${a.id})" style="cursor:pointer">
    <td><strong>${esc(a.name)}</strong><div class="muted mono" style="font-size:.55rem;margin-top:2px">${a.athlete_no||'—'}</div></td>
    <td>${levelBadge(a)}</td>
    <td class="mono">${(a.xp_total||0).toLocaleString()}</td>
    <td>${standingMini(a.standing_score)}</td>
    <td>${statusBadge(a.athlete_status)}</td>
    <td class="mono">${(a.coin_balance||0).toLocaleString()}</td>
    <td class="muted">${a.joined_at ? new Date(a.joined_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) : '—'}</td>
    <td><button class="ah-btn ah-btn-sm ah-btn-outline" onclick="event.stopPropagation();openAthleteDrawer(${a.id})">View</button></td>
  </tr>`).join('');
}

document.getElementById('athleteSearch')?.addEventListener('input', renderAthletes);
document.getElementById('athleteFilter')?.addEventListener('change', renderAthletes);

// ── APPLICATIONS ──
function renderApplications() {
  document.getElementById('appsTable').innerHTML = applications.map(a => `<tr>
    <td><strong>${esc(a.payload?.name || a.email)}</strong><div class="muted" style="font-size:.6rem">${a.email} · ${a.phone}</div></td>
    <td class="mono">${a.primary_handle || '—'}</td>
    <td class="mono">${a.auto_score || 0}</td>
    <td>${statusBadge(a.status)}</td>
    <td class="muted">${new Date(a.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short'})}</td>
    <td>
      ${a.status === 'APPLIED' ? `<button class="ah-btn ah-btn-sm" onclick="approveApp(${a.id})">Approve</button>` : ''}
      ${a.status === 'APPLIED' ? `<button class="ah-btn ah-btn-sm ah-btn-danger" onclick="rejectApp(${a.id})">Reject</button>` : ''}
    </td>
  </tr>`).join('');
}

// ── TASKS ──
let editingTaskId = null;
let deletingTaskId = null;
let assigningTaskId = null;

function renderTasks() {
  const search = (document.getElementById('taskSearch')?.value || '').toLowerCase();
  const typeFilter = document.getElementById('taskTypeFilter')?.value || '';
  const statusFilter = document.getElementById('taskStatusFilter')?.value || '';
  const trialFilter = document.getElementById('taskTrialFilter')?.value || '';

  let list = tasks;
  if (search) list = list.filter(t => (t.title||'').toLowerCase().includes(search) || (t.code||'').toLowerCase().includes(search));
  if (typeFilter) list = list.filter(t => t.type === typeFilter);
  if (statusFilter !== '') list = list.filter(t => String(t.is_active) === statusFilter);
  if (trialFilter !== '') list = list.filter(t => String(t.is_trial_task) === trialFilter);

  // Stats
  document.getElementById('taskStatTotal').textContent = tasks.length;
  document.getElementById('taskStatActive').textContent = tasks.filter(t => t.is_active).length;
  document.getElementById('taskStatAssignments').textContent = tasks.reduce((s, t) => s + (t.assignment_total || 0), 0);
  document.getElementById('taskStatApproved').textContent = tasks.reduce((s, t) => s + (t.assignment_approved || 0), 0);
  document.getElementById('taskFilterCount').textContent = list.length + ' of ' + tasks.length + ' templates';

  const tbody = document.getElementById('tasksTable');
  if (list.length === 0) {
    tbody.innerHTML = '<tr><td colspan="10" style="padding:3rem;text-align:center;color:var(--muted);font-size:.75rem">No task templates found</td></tr>';
    return;
  }

  tbody.innerHTML = list.map(t => {
    const typeLabel = t.type ? t.type.replace(/_/g, ' ') : '';
    const platformLabel = t.platform ? t.platform.charAt(0).toUpperCase() + t.platform.slice(1) : '—';
    const gateLabel = t.level_gate_name ? `${t.level_gate_name} (CL${t.level_gate_ordinal || '?'})` : '—';
    const gateTag = t.level_gate_id ? `<span class="tag gate">CL${t.level_gate_ordinal || '?'}</span>` : '';
    const trialTag = t.is_trial_task ? '<span class="tag trial">Trial</span>' : '';
    const proofTag = t.proof_type && t.proof_type !== 'URL' ? `<span class="tag">${t.proof_type}</span>` : '';

    return `<tr>
      <td><span class="task-code">${esc(t.code)}</span></td>
      <td class="task-title-cell">
        <strong>${esc(t.title)}</strong>
        ${t.brief_md ? `<div class="brief">${esc(t.brief_md)}</div>` : ''}
        <div class="task-meta" style="margin-top:4px">
          ${trialTag}${gateTag}${proofTag}
          ${t.repeatable ? '' : '<span class="tag">One-time</span>'}
          ${t.monthly_cap ? `<span class="tag">${t.monthly_cap}/mo</span>` : ''}
          ${t.cooldown_days ? `<span class="tag">${t.cooldown_days}d cool</span>` : ''}
        </div>
      </td>
      <td><span class="ah-badge">${typeLabel}</span></td>
      <td class="mono" style="font-size:.65rem">${platformLabel}</td>
      <td><span class="mono" style="font-weight:700">${t.xp_value}</span> <span class="muted" style="font-size:.55rem">XP</span> / <span class="mono" style="font-weight:700">${t.coin_value}</span> <span class="muted" style="font-size:.55rem">C</span></td>
      <td class="mono">${t.due_days}d</td>
      <td>
        <div class="task-counts">
          <span class="active-count">${t.assignment_active || 0} active</span>
          <span class="approved-count">${t.assignment_approved || 0} done</span>
          <span>${t.assignment_total || 0} total</span>
        </div>
      </td>
      <td class="mono" style="font-size:.6rem">${gateLabel}</td>
      <td>${t.is_active ? '<span class="ah-badge active">Active</span>' : '<span class="ah-badge discharged">Inactive</span>'}</td>
      <td>
        <div class="task-actions">
          <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="openTaskModal(${t.id})" title="Edit">Edit</button>
          <button class="ah-btn ah-btn-sm" onclick="openAssignModal(${t.id})" title="Assign to athletes">Assign</button>
          <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="openTaskDrawer(${t.id})" title="View details">View</button>
          <button class="ah-btn ah-btn-sm ah-btn-danger" onclick="openDeleteModal(${t.id})" title="Delete">Del</button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

// Filter listeners
document.getElementById('taskSearch')?.addEventListener('input', renderTasks);
document.getElementById('taskTypeFilter')?.addEventListener('change', renderTasks);
document.getElementById('taskStatusFilter')?.addEventListener('change', renderTasks);
document.getElementById('taskTrialFilter')?.addEventListener('change', renderTasks);

// ── TASK MODAL ──
function openTaskModal(id) {
  editingTaskId = id || null;
  const modal = document.getElementById('taskModalOverlay');
  const title = document.getElementById('taskModalTitle');
  const saveBtn = document.getElementById('taskModalSaveBtn');

  // Populate level gate dropdown
  const gateSelect = document.getElementById('taskLevelGate');
  gateSelect.innerHTML = '<option value="">None (all levels)</option>';
  [...levels].sort((a,b) => a.ordinal - b.ordinal).forEach(l => {
    gateSelect.innerHTML += `<option value="${l.id}">${l.display_name} (CL${l.ordinal})</option>`;
  });

  if (id) {
    const t = tasks.find(x => x.id === id);
    if (!t) return;
    title.textContent = 'Edit Task Template';
    saveBtn.textContent = 'Save Changes';
    document.getElementById('taskCode').value = t.code || '';
    document.getElementById('taskTitle').value = t.title || '';
    document.getElementById('taskType').value = t.type || 'CONTENT_POST';
    document.getElementById('taskPlatform').value = t.platform || '';
    document.getElementById('taskXP').value = t.xp_value || 0;
    document.getElementById('taskCoins').value = t.coin_value || 0;
    document.getElementById('taskDueDays').value = t.due_days || 7;
    document.getElementById('taskProofType').value = t.proof_type || 'URL';
    document.getElementById('taskBrief').value = t.brief_md || '';
    document.getElementById('taskDisclosure').checked = t.requires_disclosure !== false;
    document.getElementById('taskRepeatable').checked = t.repeatable !== false;
    document.getElementById('taskTrialTask').checked = t.is_trial_task || false;
    document.getElementById('taskActive').checked = t.is_active !== false;
    document.getElementById('taskCooldown').value = t.cooldown_days || 0;
    document.getElementById('taskMonthlyCap').value = t.monthly_cap || '';
    document.getElementById('taskLevelGate').value = t.level_gate_id || '';
  } else {
    title.textContent = 'New Task Template';
    saveBtn.textContent = 'Create Task';
    document.getElementById('taskForm').reset();
    document.getElementById('taskXP').value = 50;
    document.getElementById('taskCoins').value = 10;
    document.getElementById('taskDueDays').value = 7;
    document.getElementById('taskCooldown').value = 0;
    document.getElementById('taskDisclosure').checked = true;
    document.getElementById('taskRepeatable').checked = true;
    document.getElementById('taskActive').checked = true;
  }

  modal.classList.add('active');
}

function closeTaskModal() {
  document.getElementById('taskModalOverlay').classList.remove('active');
  editingTaskId = null;
}

async function saveTask() {
  const code = document.getElementById('taskCode').value.trim().toUpperCase();
  const title = document.getElementById('taskTitle').value.trim();
  if (!code || !title) return showToast('Code and Title are required', 'error');

  const body = {
    code,
    title,
    type: document.getElementById('taskType').value,
    platform: document.getElementById('taskPlatform').value || null,
    xp_value: parseInt(document.getElementById('taskXP').value) || 0,
    coin_value: parseInt(document.getElementById('taskCoins').value) || 0,
    due_days: parseInt(document.getElementById('taskDueDays').value) || 7,
    proof_type: document.getElementById('taskProofType').value,
    brief_md: document.getElementById('taskBrief').value.trim() || null,
    requires_disclosure: document.getElementById('taskDisclosure').checked,
    repeatable: document.getElementById('taskRepeatable').checked,
    is_trial_task: document.getElementById('taskTrialTask').checked,
    is_active: document.getElementById('taskActive').checked,
    cooldown_days: parseInt(document.getElementById('taskCooldown').value) || 0,
    monthly_cap: document.getElementById('taskMonthlyCap').value ? parseInt(document.getElementById('taskMonthlyCap').value) : null,
    level_gate_id: document.getElementById('taskLevelGate').value ? parseInt(document.getElementById('taskLevelGate').value) : null
  };

  try {
    const url = editingTaskId ? `${API}/tasks/${editingTaskId}` : `${API}/tasks`;
    const method = editingTaskId ? 'PUT' : 'POST';
    const res = await fetch(url, {
      method,
      headers: { 'Authorization': 'Bearer ' + adminToken, 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const data = await res.json();
    if (data.success) {
      closeTaskModal();
      await refreshData();
      showToast(editingTaskId ? 'Task template updated' : 'Task template created', 'success');
    } else {
      showToast(data.error || 'Failed to save', 'error');
    }
  } catch (err) {
    showToast('Network error', 'error');
  }
}

// ── ASSIGN MODAL ──
function openAssignModal(id) {
  const t = tasks.find(x => x.id === id);
  if (!t) return;
  assigningTaskId = id;

  document.getElementById('assignTaskName').textContent = t.title;
  document.getElementById('assignTaskCode').textContent = t.code;
  document.getElementById('assignDefaultDue').textContent = `Default: ${t.due_days} days`;
  document.getElementById('assignDueDays').value = '';
  document.getElementById('assignDueDays').placeholder = `Default: ${t.due_days} days`;

  // Render athlete list
  const list = document.getElementById('assignAthleteList');
  const activeAthletes = athletes.filter(a => ['ACTIVE', 'ON_TRIAL'].includes(a.athlete_status));
  list.innerHTML = activeAthletes.map(a => `
    <div class="ah-assign-item">
      <input type="checkbox" value="${a.id}" class="assign-checkbox" onchange="updateAssignCount()">
      <span class="name">${esc(a.name)}</span>
      <span class="meta">${a.athlete_no || ''} · ${a.athlete_status}</span>
    </div>
  `).join('');

  document.getElementById('assignSelectedCount').textContent = '0 selected';
  document.getElementById('assignModalOverlay').classList.add('active');
}

function closeAssignModal() {
  document.getElementById('assignModalOverlay').classList.remove('active');
  assigningTaskId = null;
}

function toggleAllAssignees() {
  const checkboxes = document.querySelectorAll('.assign-checkbox');
  const allChecked = [...checkboxes].every(c => c.checked);
  checkboxes.forEach(c => c.checked = !allChecked);
  updateAssignCount();
}

function updateAssignCount() {
  const count = document.querySelectorAll('.assign-checkbox:checked').length;
  document.getElementById('assignSelectedCount').textContent = count + ' selected';
}

async function confirmAssign() {
  const selected = [...document.querySelectorAll('.assign-checkbox:checked')].map(c => c.value);
  if (selected.length === 0) return showToast('Select at least one athlete', 'error');

  const dueOverride = document.getElementById('assignDueDays').value;
  try {
    const res = await fetch(`${API}/tasks/${assigningTaskId}/assign`, {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + adminToken, 'Content-Type': 'application/json' },
      body: JSON.stringify({ athlete_ids: selected, due_days_override: dueOverride || null })
    });
    const data = await res.json();
    if (data.success) {
      closeAssignModal();
      await refreshData();
      showToast(`Assigned to ${data.count} athlete(s)`, 'success');
    } else {
      showToast(data.error || 'Assignment failed', 'error');
    }
  } catch (err) {
    showToast('Network error', 'error');
  }
}

// ── DELETE MODAL ──
function openDeleteModal(id) {
  const t = tasks.find(x => x.id === id);
  if (!t) return;
  deletingTaskId = id;
  document.getElementById('deleteTaskName').textContent = t.title;
  const warning = document.getElementById('deleteWarning');
  if (t.assignment_total > 0) {
    warning.textContent = `This template has ${t.assignment_total} assignment(s) and cannot be deleted. Deactivate it instead.`;
    document.getElementById('deleteConfirmBtn').style.display = 'none';
  } else {
    warning.textContent = '';
    document.getElementById('deleteConfirmBtn').style.display = '';
  }
  document.getElementById('deleteModalOverlay').classList.add('active');
}

function closeDeleteModal() {
  document.getElementById('deleteModalOverlay').classList.remove('active');
  deletingTaskId = null;
}

async function confirmDelete() {
  if (!deletingTaskId) return;
  try {
    const res = await fetch(`${API}/tasks/${deletingTaskId}`, {
      method: 'DELETE',
      headers: { 'Authorization': 'Bearer ' + adminToken }
    });
    const data = await res.json();
    if (data.success) {
      closeDeleteModal();
      await refreshData();
      showToast('Task template deleted', 'success');
    } else {
      showToast(data.error || 'Delete failed', 'error');
    }
  } catch (err) {
    showToast('Network error', 'error');
  }
}

