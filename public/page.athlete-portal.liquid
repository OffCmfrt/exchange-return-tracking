{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Athlete Portal — Offcomfrt</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#ffffff;--surface:#f7f7f8;--surface-2:#efeff1;--surface-3:#e8e8ec;
  --border:#e5e5ea;--border-2:#d1d1d6;
  --text:#111;--text-2:#555;--muted:#8e8e93;--faint:#c7c7cc;
  --accent:#000;--accent-light:#f0f0f0;
  --success:#34c759;--danger:#ff3b30;--warning:#ff9500;--info:#007aff;
  --xp-fill:#000;--coin-color:#ff9500;--streak-color:#ff3b30;
  --radius:16px;--radius-sm:12px;--radius-xs:8px;
  --shadow:0 1px 3px rgba(0,0,0,.06),0 1px 2px rgba(0,0,0,.04);
  --shadow-md:0 4px 12px rgba(0,0,0,.08);
  --shadow-lg:0 8px 24px rgba(0,0,0,.12);
  --transition:.2s ease;
  --font:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --nav-height:64px;
}
html,body{background:var(--bg);color:var(--text);font-family:var(--font);
  min-height:100vh;-webkit-font-smoothing:antialiased;overflow-x:hidden;
  padding-bottom:var(--nav-height)}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes scaleIn{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes confetti{0%{transform:translateY(0) rotate(0)}100%{transform:translateY(-200px) rotate(720deg);opacity:0}}
@keyframes xpFill{from{width:0}to{width:var(--fill)}}
@keyframes glow{0%,100%{box-shadow:0 0 0 0 rgba(0,0,0,.1)}50%{box-shadow:0 0 0 8px rgba(0,0,0,.05)}}

/* LOADING */
.ap-loading{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:1rem;z-index:9999;transition:opacity .4s}
.ap-loading.out{opacity:0;pointer-events:none}
.ap-spinner{width:32px;height:32px;border:2.5px solid var(--border);border-top-color:var(--text);
  border-radius:50%;animation:spin .7s linear infinite}
.ap-loading p{font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}

/* AUTH */
.ap-auth{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;
  justify-content:center;padding:1.5rem;z-index:800}
.ap-auth-card{background:var(--bg);width:100%;max-width:380px;padding:2.5rem 1.5rem;
  text-align:center;animation:fadeUp .5s ease both}
.ap-auth-logo{font-size:1.8rem;font-weight:900;letter-spacing:-.02em;margin-bottom:.5rem}
.ap-auth-sub{font-size:.8rem;color:var(--muted);margin-bottom:2rem;line-height:1.5}
.ap-input-group{text-align:left;margin-bottom:1rem}
.ap-input-group label{display:block;font-size:.7rem;font-weight:600;color:var(--text-2);
  margin-bottom:.4rem;text-transform:uppercase;letter-spacing:.05em}
.ap-input{width:100%;background:var(--surface);border:1.5px solid var(--border);color:var(--text);
  padding:.85rem 1rem;font-size:.9rem;font-family:var(--font);border-radius:var(--radius-sm);
  outline:none;transition:border-color var(--transition)}
.ap-input:focus{border-color:var(--accent)}
.ap-input::placeholder{color:var(--faint)}
.ap-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;
  background:var(--accent);color:#fff;border:none;padding:.85rem 1.5rem;
  font-size:.8rem;font-weight:700;letter-spacing:.02em;font-family:var(--font);
  cursor:pointer;border-radius:var(--radius-sm);transition:all var(--transition);width:100%}
.ap-btn:hover{opacity:.85;transform:translateY(-1px)}
.ap-btn:active{transform:translateY(0)}
.ap-btn-sm{padding:.55rem 1rem;font-size:.7rem;width:auto}
.ap-btn-outline{background:transparent;color:var(--text);border:1.5px solid var(--border)}
.ap-btn-outline:hover{border-color:var(--accent);opacity:1}
.ap-btn-success{background:var(--success)}
.ap-btn-danger{background:var(--danger)}
.ap-auth-err{font-size:.75rem;color:var(--danger);margin-top:.75rem;min-height:1.2em}

/* SHELL */
.ap-shell{display:none;min-height:100vh}
.ap-shell.active{display:block;animation:fadeIn .3s ease}

/* TOP HEADER */
.ap-header{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.92);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);padding:.75rem 1rem;
  display:flex;align-items:center;justify-content:space-between}
.ap-header-left{display:flex;align-items:center;gap:.6rem}
.ap-avatar{width:36px;height:36px;border-radius:50%;background:var(--surface-2);
  display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.8rem;
  color:var(--text);border:2px solid var(--border)}
.ap-header-info h1{font-size:.85rem;font-weight:700;line-height:1.2}
.ap-header-info span{font-size:.65rem;color:var(--muted);font-weight:500}
.ap-header-right{display:flex;align-items:center;gap:.75rem}
.ap-coin-badge{display:flex;align-items:center;gap:.3rem;background:var(--surface);
  padding:.35rem .65rem;border-radius:20px;font-size:.75rem;font-weight:700}
.ap-coin-badge .coin-icon{font-size:.85rem}
.ap-level-badge{width:32px;height:32px;border-radius:50%;background:var(--accent);
  color:#fff;display:flex;align-items:center;justify-content:center;
  font-weight:800;font-size:.75rem}

/* BOTTOM NAV */
.ap-bottom-nav{position:fixed;bottom:0;left:0;right:0;z-index:200;
  background:rgba(255,255,255,.95);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-top:1px solid var(--border);display:flex;height:var(--nav-height);
  padding-bottom:env(safe-area-inset-bottom)}
.ap-nav-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:.2rem;cursor:pointer;color:var(--muted);transition:color var(--transition);
  position:relative;-webkit-tap-highlight-color:transparent}
.ap-nav-item.active{color:var(--accent)}
.ap-nav-item .nav-icon{font-size:1.3rem;line-height:1}
.ap-nav-item .nav-label{font-size:.6rem;font-weight:600;letter-spacing:.02em}
.ap-nav-badge{position:absolute;top:6px;right:50%;transform:translateX(14px);
  background:var(--danger);color:#fff;font-size:.55rem;font-weight:700;
  min-width:16px;height:16px;border-radius:8px;display:flex;align-items:center;
  justify-content:center;padding:0 4px}

/* MAIN CONTENT */
.ap-main{padding:1rem;max-width:600px;margin:0 auto}
.ap-section{display:none;animation:fadeUp .3s ease both}
.ap-section.active{display:block}

/* CARDS */
.ap-card{background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);
  padding:1.25rem;margin-bottom:.75rem;box-shadow:var(--shadow);transition:all var(--transition)}
.ap-card:hover{box-shadow:var(--shadow-md)}
.ap-card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem}
.ap-card-title{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-2)}
.ap-card-action{font-size:.7rem;font-weight:600;color:var(--info);cursor:pointer}

/* XP PROGRESS */
.ap-xp-card{text-align:center;padding:1.5rem 1.25rem}
.ap-xp-ring{width:140px;height:140px;margin:0 auto 1rem;position:relative}
.ap-xp-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.ap-xp-ring circle{fill:none;stroke-width:6}
.ap-xp-ring .track{stroke:var(--surface-2)}
.ap-xp-ring .fill{stroke:var(--accent);stroke-linecap:round;
  transition:stroke-dashoffset 1.2s cubic-bezier(.4,0,.2,1)}
.ap-xp-center{position:absolute;inset:0;display:flex;flex-direction:column;
  align-items:center;justify-content:center}
.ap-xp-center .level-name{font-size:.65rem;font-weight:700;text-transform:uppercase;
  letter-spacing:.08em;color:var(--muted);margin-bottom:.15rem}
.ap-xp-center .xp-value{font-size:1.6rem;font-weight:900;letter-spacing:-.02em}
.ap-xp-center .xp-next{font-size:.65rem;color:var(--muted);margin-top:.1rem}
.ap-xp-bar{height:6px;background:var(--surface-2);border-radius:3px;overflow:hidden;margin-top:.75rem}
.ap-xp-bar-fill{height:100%;background:var(--accent);border-radius:3px;
  transition:width 1s cubic-bezier(.4,0,.2,1)}
.ap-xp-meta{display:flex;justify-content:space-between;margin-top:.4rem;
  font-size:.65rem;color:var(--muted)}

/* STATS ROW */
.ap-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-bottom:.75rem}
.ap-stat{background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);
  padding:.85rem .5rem;text-align:center;box-shadow:var(--shadow)}
.ap-stat .stat-icon{font-size:1.3rem;margin-bottom:.25rem}
.ap-stat .stat-value{font-size:1.1rem;font-weight:800;letter-spacing:-.01em}
.ap-stat .stat-label{font-size:.55rem;color:var(--muted);font-weight:600;
  text-transform:uppercase;letter-spacing:.04em;margin-top:.1rem}
.ap-stat.streak .stat-value{color:var(--streak-color)}
.ap-stat.coins .stat-value{color:var(--coin-color)}

/* DAILY TASK CARDS (horizontal scroll on home) */
.ap-tasks-scroll{display:flex;gap:.6rem;overflow-x:auto;padding:.25rem 0 .5rem;
  -webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory;scrollbar-width:none}
.ap-tasks-scroll::-webkit-scrollbar{display:none}
.ap-task-mini{min-width:180px;max-width:200px;background:var(--bg);border:1px solid var(--border);
  border-radius:var(--radius-sm);padding:1rem;scroll-snap-align:start;
  box-shadow:var(--shadow);flex-shrink:0;cursor:pointer;transition:all var(--transition)}
.ap-task-mini:hover{box-shadow:var(--shadow-md);transform:translateY(-2px)}
.ap-task-mini .task-type{font-size:.55rem;font-weight:700;text-transform:uppercase;
  letter-spacing:.06em;color:var(--muted);margin-bottom:.4rem;
  display:flex;align-items:center;gap:.3rem}
.ap-task-mini .task-type .type-dot{width:6px;height:6px;border-radius:50%;background:var(--info)}
.ap-task-mini .task-title{font-size:.8rem;font-weight:700;margin-bottom:.5rem;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.3}
.ap-task-mini .task-rewards{display:flex;gap:.6rem;font-size:.65rem;font-weight:700}
.ap-task-mini .task-rewards .xp{color:var(--accent)}
.ap-task-mini .task-rewards .coins{color:var(--coin-color)}
.ap-task-mini .task-status{margin-top:.5rem;font-size:.55rem;font-weight:600;
  text-transform:uppercase;letter-spacing:.04em}
.ap-task-mini .task-status.picked{color:var(--info)}
.ap-task-mini .task-status.completed{color:var(--success)}
.ap-task-mini .task-status.available{color:var(--muted)}

/* FULL TASK CARDS (tasks tab) */
.ap-task-full{background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);
  padding:1rem 1.25rem;margin-bottom:.6rem;box-shadow:var(--shadow);
  display:grid;grid-template-columns:1fr auto;gap:.75rem;align-items:center;
  cursor:pointer;transition:all var(--transition)}
.ap-task-full:hover{box-shadow:var(--shadow-md)}
.ap-task-full .task-left{}
.ap-task-full .task-type{font-size:.55rem;font-weight:700;text-transform:uppercase;
  letter-spacing:.06em;color:var(--muted);margin-bottom:.3rem;
  display:flex;align-items:center;gap:.3rem}
.ap-task-full .task-title{font-size:.9rem;font-weight:700;margin-bottom:.25rem}
.ap-task-full .task-brief{font-size:.75rem;color:var(--text-2);line-height:1.4;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:.5rem}
.ap-task-full .task-rewards{display:flex;gap:.75rem;font-size:.7rem;font-weight:700}
.ap-task-full .task-right{text-align:center}
.ap-task-full .task-right .pick-btn{background:var(--accent);color:#fff;border:none;
  padding:.5rem 1rem;border-radius:var(--radius-xs);font-size:.7rem;font-weight:700;
  font-family:var(--font);cursor:pointer;transition:all var(--transition)}
.ap-task-full .task-right .pick-btn:hover{opacity:.85}
.ap-task-full .task-right .pick-btn:disabled{background:var(--faint);cursor:default}
.ap-task-full .task-right .status-badge{font-size:.55rem;font-weight:700;
  text-transform:uppercase;letter-spacing:.04em;padding:.25rem .5rem;
  border-radius:4px;margin-top:.3rem;display:inline-block}
.status-badge.assigned{background:var(--surface-2);color:var(--text-2)}
.status-badge.in_progress{background:#fff3cd;color:#856404}
.status-badge.submitted{background:#d1ecf1;color:#0c5460}
.status-badge.approved{background:#d4edda;color:#155724}
.status-badge.picked{background:#e8f0fe;color:var(--info)}

/* WEEKLY CHALLENGE */
.ap-weekly-hero{background:linear-gradient(135deg,#111 0%,#333 100%);color:#fff;
  border-radius:var(--radius);padding:1.5rem;margin-bottom:.75rem;text-align:center;
  position:relative;overflow:hidden}
.ap-weekly-hero .weekly-emoji{font-size:2.5rem;margin-bottom:.5rem}
.ap-weekly-hero h2{font-size:1.1rem;font-weight:800;margin-bottom:.3rem}
.ap-weekly-hero p{font-size:.75rem;opacity:.8;line-height:1.4;margin-bottom:.75rem}
.ap-weekly-hero .rewards-row{display:flex;justify-content:center;gap:1rem;
  font-size:.75rem;font-weight:700}
.ap-weekly-hero .countdown{margin-top:.75rem;font-size:.65rem;opacity:.7;
  font-weight:600;letter-spacing:.04em}
.ap-weekly-entry{background:var(--bg);border:1px solid var(--border);
  border-radius:var(--radius);padding:1.25rem;margin-bottom:.75rem;box-shadow:var(--shadow)}
.ap-weekly-entry h3{font-size:.8rem;font-weight:700;margin-bottom:.75rem}

/* LEADERBOARD */
.ap-podium{display:flex;align-items:flex-end;justify-content:center;gap:.5rem;
  margin-bottom:1.25rem;padding:0 .5rem}
.ap-podium-item{text-align:center;flex:1;max-width:120px}
.ap-podium-item .podium-rank{font-size:1.5rem;margin-bottom:.25rem}
.ap-podium-item .podium-name{font-size:.75rem;font-weight:700;margin-bottom:.1rem;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ap-podium-item .podium-xp{font-size:.65rem;color:var(--muted);font-weight:600}
.ap-podium-item .podium-bar{border-radius:var(--radius-xs) var(--radius-xs) 0 0;
  margin-top:.4rem;transition:height .5s ease}
.ap-podium-item:nth-child(2) .podium-bar{height:80px;background:var(--accent)}
.ap-podium-item:nth-child(1) .podium-bar{height:60px;background:var(--surface-3)}
.ap-podium-item:nth-child(3) .podium-bar{height:45px;background:var(--surface-3)}
.ap-lb-row{display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem;
  border-bottom:1px solid var(--border);transition:background var(--transition)}
.ap-lb-row:hover{background:var(--surface)}
.ap-lb-row.self{background:var(--accent-light);border-radius:var(--radius-xs);
  border:1px solid var(--border);margin-bottom:.25rem}
.ap-lb-rank{width:28px;font-weight:800;font-size:.85rem;text-align:center;color:var(--muted)}
.ap-lb-info{flex:1}
.ap-lb-name{font-size:.8rem;font-weight:600}
.ap-lb-level{font-size:.6rem;color:var(--muted)}
.ap-lb-xp{font-size:.8rem;font-weight:800;font-family:var(--font)}

/* BADGES ROW */
.ap-badges-scroll{display:flex;gap:.5rem;overflow-x:auto;padding:.25rem 0;
  -webkit-overflow-scrolling:touch;scrollbar-width:none}
.ap-badges-scroll::-webkit-scrollbar{display:none}
.ap-badge-item{min-width:64px;text-align:center;flex-shrink:0}
.ap-badge-icon{width:48px;height:48px;border-radius:50%;background:var(--surface);
  border:2px solid var(--border);display:flex;align-items:center;justify-content:center;
  font-size:1.3rem;margin:0 auto .25rem}
.ap-badge-name{font-size:.5rem;font-weight:600;color:var(--muted);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:64px}

/* WEEKLY LEADERBOARD */
.ap-weekly-lb-header{display:flex;justify-content:space-between;align-items:center;
  margin-bottom:.75rem}
.ap-weekly-lb-header h3{font-size:.8rem;font-weight:700}
.ap-weekly-lb-header span{font-size:.65rem;color:var(--muted);font-weight:600}

/* EARNINGS */
.ap-earnings-lock{text-align:center;padding:3rem 1.5rem}
.ap-earnings-lock .lock-icon{font-size:2rem;margin-bottom:1rem;opacity:.3}
.ap-earnings-lock p{font-size:.8rem;color:var(--muted);max-width:320px;margin:0 auto 1.25rem;line-height:1.5}
.ap-earnings-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-top:1rem}
.ap-earnings-cell{background:var(--bg);border:1px solid var(--border);
  border-radius:var(--radius-sm);padding:1rem;text-align:center;box-shadow:var(--shadow)}
.ap-earnings-cell .val{font-size:1.1rem;font-weight:800;margin-bottom:.2rem}
.ap-earnings-cell .lbl{font-size:.55rem;color:var(--muted);font-weight:600;
  text-transform:uppercase;letter-spacing:.04em}

/* SUBMISSION MODAL */
.ap-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:500;
  display:none;align-items:flex-end;justify-content:center}
.ap-modal-overlay.active{display:flex}
.ap-modal{background:var(--bg);border-radius:var(--radius) var(--radius) 0 0;
  width:100%;max-width:600px;animation:slideUp .3s ease both;padding:1.5rem;
  padding-bottom:calc(1.5rem + env(safe-area-inset-bottom))}
.ap-modal-handle{width:36px;height:4px;background:var(--surface-3);
  border-radius:2px;margin:0 auto 1rem}
.ap-modal h3{font-size:.9rem;font-weight:700;margin-bottom:1rem}
.ap-modal .ap-input-group{margin-bottom:.85rem}
.ap-modal textarea{width:100%;background:var(--surface);border:1.5px solid var(--border);
  color:var(--text);padding:.75rem 1rem;font-size:.85rem;font-family:var(--font);
  resize:vertical;min-height:80px;border-radius:var(--radius-xs);outline:none;
  transition:border-color var(--transition)}
.ap-modal textarea:focus{border-color:var(--accent)}
.ap-modal-actions{display:flex;gap:.5rem;margin-top:1rem}
.ap-modal-actions .ap-btn{flex:1}

/* CONFETTI */
.ap-confetti{position:fixed;top:0;left:0;right:0;height:100vh;pointer-events:none;z-index:9999}
.confetti-piece{position:absolute;width:8px;height:8px;border-radius:2px;
  animation:confetti 1.5s ease-out forwards}

/* SECTION HEADERS */
.ap-section-header{display:flex;justify-content:space-between;align-items:center;
  margin-bottom:.75rem;margin-top:.5rem}
.ap-section-header h2{font-size:.85rem;font-weight:800}
.ap-section-header .count{font-size:.7rem;color:var(--muted);font-weight:600}

/* EMPTY STATE */
.ap-empty{text-align:center;padding:2.5rem 1rem;color:var(--muted)}
.ap-empty .empty-icon{font-size:2rem;margin-bottom:.75rem;opacity:.5}
.ap-empty p{font-size:.8rem;line-height:1.5}

/* TABS (for leaderboard periods) */
.ap-tabs{display:flex;gap:.25rem;background:var(--surface);border-radius:var(--radius-xs);
  padding:3px;margin-bottom:1rem}
.ap-tab{flex:1;text-align:center;padding:.5rem;font-size:.7rem;font-weight:600;
  color:var(--muted);cursor:pointer;border-radius:6px;transition:all var(--transition)}
.ap-tab.active{background:var(--bg);color:var(--text);box-shadow:var(--shadow)}

/* RESPONSIVE — tablet+ */
@media(min-width:768px){
  .ap-main{padding:1.5rem;max-width:640px}
  .ap-stats{grid-template-columns:repeat(3,1fr);gap:.75rem}
  .ap-task-mini{min-width:200px}
  .ap-earnings-grid{grid-template-columns:repeat(3,1fr)}
}
</style>
</head>
<body>

<!-- LOADING -->
<div class="ap-loading" id="loading">
  <div class="ap-spinner"></div>
  <p>Loading</p>
</div>

<!-- AUTH -->
<div class="ap-auth" id="auth" style="display:none">
  <div class="ap-auth-card">
    <div class="ap-auth-logo">OFFCOMFRT</div>
    <p class="ap-auth-sub">Enter your athlete access link to unlock your portal.</p>
    <form id="authForm">
      <div class="ap-input-group">
        <label>Access Token</label>
        <input type="password" class="ap-input" id="tokenInput" placeholder="Paste your access link" autocomplete="off" required>
      </div>
      <button type="submit" class="ap-btn">Enter Portal</button>
      <div class="ap-auth-err" id="authErr"></div>
    </form>
  </div>
</div>

<!-- SHELL -->
<div class="ap-shell" id="shell">
  <!-- HEADER -->
  <header class="ap-header">
    <div class="ap-header-left">
      <div class="ap-avatar" id="headerAvatar">?</div>
      <div class="ap-header-info">
        <h1 id="headerName">Athlete</h1>
        <span id="headerNo">OFC-0000</span>
      </div>
    </div>
    <div class="ap-header-right">
      <div class="ap-coin-badge"><span class="coin-icon">🪙</span><span id="headerCoins">0</span></div>
      <div class="ap-level-badge" id="headerLevel">—</div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="ap-main">
    <!-- ═══ HOME ═══ -->
    <div class="ap-section active" id="sec-home">
      <!-- XP Ring -->
      <div class="ap-card ap-xp-card">
        <div class="ap-xp-ring">
          <svg viewBox="0 0 140 140">
            <circle class="track" cx="70" cy="70" r="60"/>
            <circle class="fill" id="xpArc" cx="70" cy="70" r="60"
              stroke-dasharray="376.99" stroke-dashoffset="376.99"/>
          </svg>
          <div class="ap-xp-center">
            <div class="level-name" id="homeLevelName">—</div>
            <div class="xp-value" id="homeXp">0</div>
            <div class="xp-next" id="homeXpNext">/ 0 XP</div>
          </div>
        </div>
        <div class="ap-xp-bar"><div class="ap-xp-bar-fill" id="xpBarFill" style="width:0%"></div></div>
        <div class="ap-xp-meta"><span id="xpProgress">0%</span><span id="xpToNext">to next level</span></div>
      </div>

      <!-- Stats -->
      <div class="ap-stats">
        <div class="ap-stat streak">
          <div class="stat-icon">🔥</div>
          <div class="stat-value" id="homeStreak">0</div>
          <div class="stat-label">Day Streak</div>
        </div>
        <div class="ap-stat">
          <div class="stat-icon">⚡</div>
          <div class="stat-value" id="homeStanding">0</div>
          <div class="stat-label">Standing</div>
        </div>
        <div class="ap-stat coins">
          <div class="stat-icon">🪙</div>
          <div class="stat-value" id="homeCoins">0</div>
          <div class="stat-label">Coins</div>
        </div>
      </div>

      <!-- Daily Tasks Preview -->
      <div class="ap-section-header">
        <h2>Today's Missions</h2>
        <span class="count" id="homeTaskCount">0/5 picked</span>
      </div>
      <div class="ap-tasks-scroll" id="homeTasksScroll">
        <div class="ap-empty" style="min-width:100%"><p>Loading missions...</p></div>
      </div>

      <!-- Weekly Challenge Banner -->
      <div class="ap-section-header" style="margin-top:.5rem">
        <h2>Weekly Challenge</h2>
      </div>
      <div id="homeWeeklyBanner">
        <div class="ap-empty"><p>Loading...</p></div>
      </div>

      <!-- Badges -->
      <div class="ap-section-header" style="margin-top:.5rem">
        <h2>Badges</h2>
        <span class="count" id="homeBadgeCount">0 earned</span>
      </div>
      <div class="ap-badges-scroll" id="homeBadges">
        <div class="ap-empty" style="min-width:100%"><p>No badges yet</p></div>
      </div>
    </div>

    <!-- ═══ TASKS ═══ -->
    <div class="ap-section" id="sec-tasks">
      <div class="ap-section-header">
        <h2>Today's Missions</h2>
        <span class="count" id="taskPickCount">0/5</span>
      </div>
      <div id="taskList">
        <div class="ap-empty"><p>Loading missions...</p></div>
      </div>
    </div>

    <!-- ═══ WEEKLY ═══ -->
    <div class="ap-section" id="sec-weekly">
      <div id="weeklyContent">
        <div class="ap-empty"><p>Loading challenge...</p></div>
      </div>
    </div>

    <!-- ═══ LEADERBOARD ═══ -->
    <div class="ap-section" id="sec-leaderboard">
      <div class="ap-tabs" id="lbTabs">
        <div class="ap-tab active" data-period="weekly">Weekly</div>
        <div class="ap-tab" data-period="monthly">Monthly</div>
        <div class="ap-tab" data-period="all_time">All Time</div>
      </div>
      <div id="lbContent">
        <div class="ap-empty"><p>Loading leaderboard...</p></div>
      </div>
    </div>

    <!-- ═══ EARNINGS ═══ -->
    <div class="ap-section" id="sec-earnings">
      <div class="ap-earnings-lock" id="earningsLock">
        <div class="lock-icon">🔒</div>
        <p>Financial data requires identity verification.</p>
        <button class="ap-btn" style="max-width:240px;margin:0 auto" id="unlockEarnings">Verify & View</button>
      </div>
      <div id="earningsContent" style="display:none">
        <div class="ap-earnings-grid">
          <div class="ap-earnings-cell"><div class="val" id="earnTotal">₹0</div><div class="lbl">Total</div></div>
          <div class="ap-earnings-cell"><div class="val" id="earnPending">₹0</div><div class="lbl">Pending</div></div>
          <div class="ap-earnings-cell"><div class="val" id="earnPaid">₹0</div><div class="lbl">Paid</div></div>
        </div>
      </div>
    </div>
  </main>

  <!-- BOTTOM NAV -->
  <nav class="ap-bottom-nav">
    <div class="ap-nav-item active" data-tab="home">
      <span class="nav-icon">🏠</span>
      <span class="nav-label">Home</span>
    </div>
    <div class="ap-nav-item" data-tab="tasks">
      <span class="nav-icon">🎯</span>
      <span class="nav-label">Tasks</span>
      <span class="ap-nav-badge" id="taskBadge" style="display:none">0</span>
    </div>
    <div class="ap-nav-item" data-tab="weekly">
      <span class="nav-icon">🏆</span>
      <span class="nav-label">Weekly</span>
    </div>
    <div class="ap-nav-item" data-tab="leaderboard">
      <span class="nav-icon">📊</span>
      <span class="nav-label">Board</span>
    </div>
    <div class="ap-nav-item" data-tab="earnings">
      <span class="nav-icon">💰</span>
      <span class="nav-label">Earnings</span>
    </div>
  </nav>
</div>

<!-- SUBMISSION MODAL -->
<div class="ap-modal-overlay" id="submitModal">
  <div class="ap-modal">
    <div class="ap-modal-handle"></div>
    <h3>Submit Proof</h3>
    <div class="ap-input-group">
      <label>Post URL</label>
      <input type="url" class="ap-input" id="submitUrl" placeholder="https://instagram.com/reel/...">
    </div>
    <div class="ap-input-group">
      <label>Caption</label>
      <textarea id="submitCaption" placeholder="What did you post about?"></textarea>
    </div>
    <div class="ap-input-group">
      <label style="display:flex;align-items:center;gap:.4rem;cursor:pointer;font-size:.8rem;text-transform:none;letter-spacing:0">
        <input type="checkbox" id="submitDisclosure"> #ad or sponsored tag included
      </label>
    </div>
    <div class="ap-modal-actions">
      <button class="ap-btn ap-btn-outline" onclick="closeModal()">Cancel</button>
      <button class="ap-btn" id="submitBtn">Submit</button>
    </div>
  </div>
</div>

<script>
const API = 'https://exchange-return-tracking.onrender.com/api/athlete';
let S = { token: null, athlete: null, dailyTasks: null, weekly: null, streak: null, badges: [], leaderboard: [], weeklyLb: [] };

// ── INIT ──
document.addEventListener('DOMContentLoaded', () => {
  const saved = sessionStorage.getItem('ap_token');
  if (saved) { S.token = saved; loadAll(); }
  else { showAuth(); }
  setupNav();
  setupAuth();
  setupEarnings();
  setupLbTabs();
});

function showAuth() {
  document.getElementById('loading').classList.add('out');
  document.getElementById('auth').style.display = 'flex';
}

function setupAuth() {
  document.getElementById('authForm').addEventListener('submit', async e => {
    e.preventDefault();
    S.token = document.getElementById('tokenInput').value.trim();
    sessionStorage.setItem('ap_token', S.token);
    await loadAll();
  });
}

async function loadAll() {
  try {
    const res = await fetch(`${API}/${S.token}/progress`);
    if (!res.ok) throw new Error('Invalid token');
    const data = await res.json();
    if (!data.success) throw new Error(data.error || 'Failed');
    S.athlete = data.data;
    showShell();
    loadDailyTasks();
    loadWeekly();
    loadStreak();
    loadBadges();
    loadLeaderboard('all_time');
  } catch (err) {
    sessionStorage.removeItem('ap_token');
    S.token = null;
    document.getElementById('authErr').textContent = 'Invalid or expired access link';
    showAuth();
  }
}

function showShell() {
  const a = S.athlete;
  document.getElementById('auth').style.display = 'none';
  document.getElementById('loading').classList.add('out');
  document.getElementById('shell').classList.add('active');

  // Header
  document.getElementById('headerAvatar').textContent = (a.name || '?')[0].toUpperCase();
  document.getElementById('headerName').textContent = a.name || 'Athlete';
  document.getElementById('headerNo').textContent = a.athlete_no || '';
  document.getElementById('headerCoins').textContent = (a.coin_balance || 0).toLocaleString();
  document.getElementById('headerLevel').textContent = a.level?.display_number ?? '—';

  // Home XP
  renderXpRing();
  document.getElementById('homeStreak').textContent = '0';
  document.getElementById('homeStanding').textContent = Math.round(a.standing_score || 0);
  document.getElementById('homeCoins').textContent = (a.coin_balance || 0).toLocaleString();
}

function renderXpRing() {
  const a = S.athlete;
  const xp = a.xp_total || 0;
  const nextMinXp = a.next_level?.min_xp || xp + 100;
  const prevMinXp = a.level?.min_xp || 0;
  const range = nextMinXp - prevMinXp;
  const progress = xp - prevMinXp;
  const pct = Math.min(100, Math.max(0, (progress / range) * 100));
  const circumference = 376.99;
  const offset = circumference - (pct / 100) * circumference;

  document.getElementById('homeLevelName').textContent = a.level?.display_name || 'Unranked';
  document.getElementById('homeXp').textContent = xp.toLocaleString();
  document.getElementById('homeXpNext').textContent = '/ ' + nextMinXp.toLocaleString() + ' XP';
  setTimeout(() => {
    document.getElementById('xpArc').style.strokeDashoffset = offset;
    document.getElementById('xpBarFill').style.width = pct.toFixed(1) + '%';
  }, 300);
  document.getElementById('xpProgress').textContent = pct.toFixed(0) + '%';
  document.getElementById('xpToNext').textContent = (nextMinXp - xp).toLocaleString() + ' XP to go';
}

// ── NAV ──
function setupNav() {
  document.querySelectorAll('.ap-nav-item').forEach(item => {
    item.addEventListener('click', () => {
      document.querySelectorAll('.ap-nav-item').forEach(n => n.classList.remove('active'));
      document.querySelectorAll('.ap-section').forEach(s => s.classList.remove('active'));
      item.classList.add('active');
      document.getElementById('sec-' + item.dataset.tab).classList.add('active');
    });
  });
}

// ── DAILY TASKS ──
async function loadDailyTasks() {
  try {
    const res = await fetch(`${API}/${S.token}/daily-tasks`);
    const data = await res.json();
    S.dailyTasks = data.data || {};
    renderHomeTasks();
    renderFullTasks();
  } catch (err) { console.error('Daily tasks load:', err); }
}

function renderHomeTasks() {
  const scroll = document.getElementById('homeTasksScroll');
  const tasks = S.dailyTasks?.tasks || [];
  const picks = S.dailyTasks?.picks || [];
  const maxPicks = S.dailyTasks?.maxPicks || 5;
  document.getElementById('homeTaskCount').textContent = picks.length + '/' + maxPicks + ' picked';

  if (tasks.length === 0) {
    scroll.innerHTML = '<div class="ap-empty" style="min-width:100%"><div class="empty-icon">🎯</div><p>No missions available today.<br>Check back tomorrow!</p></div>';
    return;
  }

  scroll.innerHTML = tasks.map(t => {
    let statusClass = 'available', statusText = 'Tap to pick';
    if (t.picked) {
      if (t.pick_status === 'APPROVED') { statusClass = 'completed'; statusText = '✓ Approved'; }
      else if (t.pick_status === 'SUBMITTED') { statusClass = 'completed'; statusText = '✓ Submitted'; }
      else { statusClass = 'picked'; statusText = '✓ Picked'; }
    }
    return `<div class="ap-task-mini" onclick="switchTab('tasks')">
      <div class="task-type"><span class="type-dot"></span>${(t.type||'TASK').replace('_',' ')}</div>
      <div class="task-title">${esc(t.title)}</div>
      <div class="task-rewards"><span class="xp">+${t.xp_value||0} XP</span><span class="coins">+${t.coin_value||0} 🪙</span></div>
      <div class="task-status ${statusClass}">${statusText}</div>
    </div>`;
  }).join('');
}

function renderFullTasks() {
  const list = document.getElementById('taskList');
  const tasks = S.dailyTasks?.tasks || [];
  const picks = S.dailyTasks?.picks || [];
  const maxPicks = S.dailyTasks?.maxPicks || 5;
  document.getElementById('taskPickCount').textContent = picks.length + '/' + maxPicks;

  // Update badge
  const available = maxPicks - picks.length;
  const badge = document.getElementById('taskBadge');
  if (available > 0 && tasks.length > 0) { badge.style.display = 'flex'; badge.textContent = available; }
  else { badge.style.display = 'none'; }

  if (tasks.length === 0) {
    list.innerHTML = '<div class="ap-empty"><div class="empty-icon">🎯</div><p>No missions today</p></div>';
    return;
  }

  list.innerHTML = tasks.map(t => {
    let btnHtml = '', statusHtml = '';
    if (t.picked) {
      statusHtml = `<div class="status-badge ${(t.pick_status||'picked').toLowerCase()}">${(t.pick_status||'PICKED').replace(/_/g,' ')}</div>`;
      if (['PICKED','ASSIGNED','IN_PROGRESS','CHANGES_REQUESTED'].includes(t.pick_status)) {
        btnHtml = `<button class="pick-btn" onclick="event.stopPropagation();openSubmit(${t.assignment_id})">Submit</button>`;
      } else {
        btnHtml = `<button class="pick-btn" disabled>Done</button>`;
      }
    } else if (picks.length >= maxPicks) {
      btnHtml = `<button class="pick-btn" disabled>Full</button>`;
    } else {
      btnHtml = `<button class="pick-btn" onclick="event.stopPropagation();pickTask(${t.id})">Pick</button>`;
    }

    return `<div class="ap-task-full">
      <div class="task-left">
        <div class="task-type"><span class="type-dot"></span>${(t.type||'TASK').replace('_',' ')}${t.platform ? ' · '+t.platform : ''}</div>
        <div class="task-title">${esc(t.title)}</div>
        <div class="task-brief">${esc(t.brief_md||t.brief||'')}</div>
        <div class="task-rewards"><span class="xp">+${t.xp_value||0} XP</span><span class="coins">+${t.coin_value||0} 🪙</span></div>
      </div>
      <div class="task-right">${btnHtml}${statusHtml}</div>
    </div>`;
  }).join('');
}

async function pickTask(templateId) {
  try {
    const res = await fetch(`${API}/${S.token}/daily-tasks/pick`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ task_template_id: templateId })
    });
    const data = await res.json();
    if (data.success) {
      fireConfetti();
      await loadDailyTasks();
    } else { alert(data.error || 'Could not pick task'); }
  } catch (err) { alert('Network error'); }
}

// ── WEEKLY CHALLENGE ──
async function loadWeekly() {
  try {
    const res = await fetch(`${API}/${S.token}/weekly-challenge`);
    const data = await res.json();
    S.weekly = data.data || {};
    renderHomeWeekly();
    renderWeeklyTab();
  } catch (err) { console.error('Weekly load:', err); }
}

function renderHomeWeekly() {
  const c = S.weekly?.challenge;
  const banner = document.getElementById('homeWeeklyBanner');
  if (!c) {
    banner.innerHTML = '<div class="ap-empty"><div class="empty-icon">🏆</div><p>No active challenge this week</p></div>';
    return;
  }
  const daysLeft = Math.ceil((new Date(c.week_end) - Date.now()) / 86400000);
  banner.innerHTML = `<div class="ap-weekly-hero" onclick="switchTab('weekly')" style="cursor:pointer">
    <div class="weekly-emoji">${c.cover_emoji || '🏆'}</div>
    <h2>${esc(c.title)}</h2>
    <p>${esc(c.description || '')}</p>
    <div class="rewards-row"><span>+${c.reward_xp||0} XP</span><span>+${c.reward_coins||0} 🪙</span></div>
    <div class="countdown">${daysLeft} day${daysLeft!==1?'s':''} left</div>
  </div>`;
}

function renderWeeklyTab() {
  const el = document.getElementById('weeklyContent');
  const c = S.weekly?.challenge;
  const entry = S.weekly?.entry;

  if (!c) {
    el.innerHTML = '<div class="ap-empty"><div class="empty-icon">🏆</div><p>No active challenge this week.<br>Stay tuned!</p></div>';
    return;
  }

  const daysLeft = Math.ceil((new Date(c.week_end) - Date.now()) / 86400000);
  let entryHtml = '';
  if (entry) {
    const statusColor = entry.status === 'APPROVED' ? 'var(--success)' : entry.status === 'REJECTED' ? 'var(--danger)' : 'var(--warning)';
    entryHtml = `<div class="ap-weekly-entry">
      <h3>Your Entry</h3>
      <p style="font-size:.75rem;color:var(--text-2);margin-bottom:.5rem">${esc(entry.submission_url||'')}</p>
      <span style="font-size:.7rem;font-weight:700;color:${statusColor}">${entry.status}</span>
    </div>`;
  } else {
    entryHtml = `<div class="ap-weekly-entry">
      <h3>Submit Your Entry</h3>
      <div class="ap-input-group"><label>Post URL</label>
        <input type="url" class="ap-input" id="weeklyUrl" placeholder="https://instagram.com/..."></div>
      <div class="ap-input-group"><label>Caption</label>
        <textarea id="weeklyCaption" placeholder="Describe your entry..." style="min-height:60px"></textarea></div>
      <div class="ap-input-group"><label style="display:flex;align-items:center;gap:.4rem;cursor:pointer;font-size:.8rem;text-transform:none;letter-spacing:0">
        <input type="checkbox" id="weeklyDisclosure"> #ad or sponsored tag included</label></div>
      <button class="ap-btn" onclick="submitWeekly()">Submit Entry</button>
    </div>`;
  }

  el.innerHTML = `
    <div class="ap-weekly-hero">
      <div class="weekly-emoji">${c.cover_emoji || '🏆'}</div>
      <h2>${esc(c.title)}</h2>
      <p>${esc(c.description || '')}</p>
      ${c.instructions ? '<p style="font-size:.7rem;opacity:.7;margin-top:.5rem">'+esc(c.instructions)+'</p>' : ''}
      <div class="rewards-row"><span>+${c.reward_xp||0} XP</span><span>+${c.reward_coins||0} 🪙</span>${c.reward_badge ? '<span>🏅 Badge</span>' : ''}</div>
      <div class="countdown">${daysLeft} day${daysLeft!==1?'s':''} left</div>
    </div>
    ${entryHtml}
    <div class="ap-weekly-lb-header"><h3>Challenge Leaderboard</h3><span id="weeklyEntryCount"></span></div>
    <div id="weeklyLbList"><div class="ap-empty"><p>Loading...</p></div></div>`;

  loadWeeklyLeaderboard(c.id);
}

async function submitWeekly() {
  const c = S.weekly?.challenge;
  if (!c) return;
  const url = document.getElementById('weeklyUrl').value.trim();
  const caption = document.getElementById('weeklyCaption').value.trim();
  const disclosure = document.getElementById('weeklyDisclosure').checked;
  if (!url) return alert('Post URL is required');

  try {
    const res = await fetch(`${API}/${S.token}/weekly-challenge/submit`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ challenge_id: c.id, submission_url: url, caption, disclosure_found: disclosure })
    });
    const data = await res.json();
    if (data.success) { fireConfetti(); await loadWeekly(); }
    else alert(data.error || 'Submission failed');
  } catch (err) { alert('Network error'); }
}

async function loadWeeklyLeaderboard(challengeId) {
  try {
    const res = await fetch(`${API}/${S.token}/weekly-leaderboard${challengeId ? '?challenge_id='+challengeId : ''}`);
    const data = await res.json();
    S.weeklyLb = data.data?.entries || [];
    renderWeeklyLb();
  } catch (err) { console.error('Weekly LB load:', err); }
}

function renderWeeklyLb() {
  const el = document.getElementById('weeklyLbList');
  if (!el) return;
  const entries = S.weeklyLb;
  const countEl = document.getElementById('weeklyEntryCount');
  if (countEl) countEl.textContent = entries.length + ' entries';

  if (entries.length === 0) {
    el.innerHTML = '<div class="ap-empty"><p>No entries yet</p></div>';
    return;
  }

  el.innerHTML = entries.map((e, i) => {
    const isSelf = S.athlete && e.influencer_id === S.athlete.id;
    return `<div class="ap-lb-row${isSelf ? ' self' : ''}">
      <div class="ap-lb-rank">${e.display_rank || i+1}</div>
      <div class="ap-lb-info"><div class="ap-lb-name">${esc(e.athlete?.name||'Unknown')}</div>
        <div class="ap-lb-level">${e.athlete?.level_name||'—'}</div></div>
      <div class="ap-lb-xp">${e.score || '—'}</div>
    </div>`;
  }).join('');
}

// ── STREAK ──
async function loadStreak() {
  try {
    const res = await fetch(`${API}/${S.token}/streak`);
    const data = await res.json();
    S.streak = data.data || {};
    document.getElementById('homeStreak').textContent = S.streak.current_streak || 0;
  } catch (err) { console.error('Streak load:', err); }
}

// ── BADGES ──
async function loadBadges() {
  try {
    const res = await fetch(`${API}/${S.token}/badges`);
    const data = await res.json();
    S.badges = data.data || [];
    renderBadges();
  } catch (err) { console.error('Badges load:', err); }
}

function renderBadges() {
  const el = document.getElementById('homeBadges');
  document.getElementById('homeBadgeCount').textContent = S.badges.length + ' earned';
  if (S.badges.length === 0) {
    el.innerHTML = '<div class="ap-empty" style="min-width:100%"><p>Complete tasks to earn badges</p></div>';
    return;
  }
  el.innerHTML = S.badges.map(b => `<div class="ap-badge-item">
    <div class="ap-badge-icon">${b.badge_icon || '🏅'}</div>
    <div class="ap-badge-name">${esc(b.badge_name)}</div>
  </div>`).join('');
}

// ── LEADERBOARD ──
function setupLbTabs() {
  document.querySelectorAll('#lbTabs .ap-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('#lbTabs .ap-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      loadLeaderboard(tab.dataset.period);
    });
  });
}

async function loadLeaderboard(period) {
  try {
    const res = await fetch(`${API}/${S.token}/leaderboard`);
    const data = await res.json();
    S.leaderboard = data.data || [];
    renderLeaderboard();
  } catch (err) { console.error('Leaderboard load:', err); }
}

function renderLeaderboard() {
  const el = document.getElementById('lbContent');
  const lb = S.leaderboard;
  if (lb.length === 0) {
    el.innerHTML = '<div class="ap-empty"><div class="empty-icon">📊</div><p>No rankings yet</p></div>';
    return;
  }

  // Podium (top 3)
  let podiumHtml = '';
  if (lb.length >= 3) {
    const order = [lb[1], lb[0], lb[2]]; // 2nd, 1st, 3rd for visual
    const ranks = ['🥈','🥇','🥉'];
    podiumHtml = '<div class="ap-podium">' + order.map((a, i) =>
      `<div class="ap-podium-item">
        <div class="podium-rank">${ranks[i]}</div>
        <div class="podium-name">${esc(a.name)}</div>
        <div class="podium-xp">${(a.xp_total||0).toLocaleString()} XP</div>
        <div class="podium-bar"></div>
      </div>`
    ).join('') + '</div>';
  }

  // Full list
  const listHtml = lb.map((a, i) => {
    const isSelf = S.athlete && a.id === S.athlete.id;
    return `<div class="ap-lb-row${isSelf ? ' self' : ''}">
      <div class="ap-lb-rank">${i+1}</div>
      <div class="ap-lb-info"><div class="ap-lb-name">${esc(a.name)}</div>
        <div class="ap-lb-level">${a.level_name||'—'}</div></div>
      <div class="ap-lb-xp">${(a.xp_total||0).toLocaleString()}</div>
    </div>`;
  }).join('');

  el.innerHTML = podiumHtml + listHtml;
}

// ── EARNINGS ──
function setupEarnings() {
  document.getElementById('unlockEarnings')?.addEventListener('click', () => {
    document.getElementById('earningsLock').style.display = 'none';
    document.getElementById('earningsContent').style.display = 'block';
  });
}

// ── SUBMISSION MODAL ──
let currentAssignmentId = null;
function openSubmit(assignmentId) {
  currentAssignmentId = assignmentId;
  document.getElementById('submitModal').classList.add('active');
}
function closeModal() {
  document.getElementById('submitModal').classList.remove('active');
  currentAssignmentId = null;
}

document.getElementById('submitBtn')?.addEventListener('click', async () => {
  if (!currentAssignmentId) return;
  const url = document.getElementById('submitUrl').value.trim();
  const caption = document.getElementById('submitCaption').value.trim();
  const disclosure = document.getElementById('submitDisclosure').checked;
  if (!url) return alert('Post URL is required');

  try {
    const res = await fetch(`${API}/${S.token}/submissions/${currentAssignmentId}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ post_url: url, caption, disclosure_found: disclosure })
    });
    const data = await res.json();
    if (data.success) { closeModal(); fireConfetti(); await loadDailyTasks(); }
    else alert(data.error || 'Submission failed');
  } catch (err) { alert('Network error'); }
});

// ── HELPERS ──
function switchTab(tab) {
  document.querySelectorAll('.ap-nav-item').forEach(n => n.classList.remove('active'));
  document.querySelectorAll('.ap-section').forEach(s => s.classList.remove('active'));
  document.querySelector(`.ap-nav-item[data-tab="${tab}"]`).classList.add('active');
  document.getElementById('sec-' + tab).classList.add('active');
}

function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

function fireConfetti() {
  const container = document.createElement('div');
  container.className = 'ap-confetti';
  document.body.appendChild(container);
  const colors = ['#ff3b30','#ff9500','#34c759','#007aff','#af52de','#ff2d55'];
  for (let i = 0; i < 30; i++) {
    const piece = document.createElement('div');
    piece.className = 'confetti-piece';
    piece.style.left = Math.random() * 100 + '%';
    piece.style.top = 60 + Math.random() * 30 + '%';
    piece.style.background = colors[Math.floor(Math.random() * colors.length)];
    piece.style.animationDelay = Math.random() * 0.5 + 's';
    piece.style.animationDuration = 1 + Math.random() * 1 + 's';
    container.appendChild(piece);
  }
  setTimeout(() => container.remove(), 3000);
}
</script>
</body>
</html>
