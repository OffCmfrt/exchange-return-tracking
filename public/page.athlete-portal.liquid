      </div>
    </div>`;
}

function copyCoupon() {
  const code = document.getElementById('couponCodeText')?.textContent || '';
  navigator.clipboard.writeText(code).then(() => {
    const btn = document.querySelector('.ap-coupon-copy');
    if (btn) btn.innerHTML = '<svg style="width:12px;height:12px"><use href="#icon-check"/></svg> Copied!';
    setTimeout(() => {
      if (btn) btn.innerHTML = '<svg style="width:12px;height:12px"><use href="#icon-copy"/></svg> Copy Code';
    }, 2000);
  }).catch(() => {});
}

// ── LEADERBOARD ──
function setupLbTabs() {
  document.querySelectorAll('#lbTabs .ap-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('#lbTabs .ap-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      loadLeaderboard(tab.dataset.period);
    });
  });
}

async function loadLeaderboard(period) {
  try {
    const res = await fetch(`${API}/${S.token}/leaderboard`);
    const data = await res.json();
    S.leaderboard = data.data || [];
    renderLeaderboard();
  } catch (err) { console.error('Leaderboard load:', err); }
}

function renderLeaderboard() {
  const el = document.getElementById('lbContent');
  const lb = S.leaderboard;
  if (lb.length === 0) {
    el.innerHTML = '<div class="ap-empty"><div class="empty-icon"><svg><use href="#icon-chart"/></svg></div><p>No rankings yet</p></div>';
    return;
  }

  let podiumHtml = '';
  if (lb.length >= 3) {
    const order = [lb[1], lb[0], lb[2]];
    const ranks = ['2','1','3'];
    podiumHtml = '<div class="ap-podium">' + order.map((a, i) =>
      `<div class="ap-podium-item">
        <div class="podium-rank">${ranks[i]}</div>
        <div class="podium-name">${esc(a.name)}</div>
        <div class="podium-xp">${(a.xp_total||0).toLocaleString()} XP</div>
        <div class="podium-bar"></div>
      </div>`
    ).join('') + '</div>';
  }

  const listHtml = lb.map((a, i) => {
    const isSelf = S.athlete && a.id === S.athlete.id;
    return `<div class="ap-lb-row${isSelf ? ' self' : ''}">
      <div class="ap-lb-rank">${i+1}</div>
      <div class="ap-lb-info"><div class="ap-lb-name">${esc(a.name)}</div>
        <div class="ap-lb-level">${a.level_name||'—'}</div></div>
      <div class="ap-lb-xp">${(a.xp_total||0).toLocaleString()}</div>
    </div>`;
  }).join('');

  el.innerHTML = podiumHtml + listHtml;
}

// ── SUBMISSION MODAL ──
let currentAssignmentId = null;
function openSubmit(assignmentId) {
  currentAssignmentId = assignmentId;
  document.getElementById('submitModal').classList.add('active');
}
function closeModal() {
  document.getElementById('submitModal').classList.remove('active');
  currentAssignmentId = null;
}

document.getElementById('submitBtn')?.addEventListener('click', async () => {
  if (!currentAssignmentId) return;
  const url = document.getElementById('submitUrl').value.trim();
  const caption = document.getElementById('submitCaption').value.trim();
  const disclosure = document.getElementById('submitDisclosure').checked;
  if (!url) return alert('Post URL is required');

  try {
    const res = await fetch(`${API}/${S.token}/submissions/${currentAssignmentId}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ post_url: url, caption, disclosure_found: disclosure })
    });
    const data = await res.json();
    if (data.success) { closeModal(); fireConfetti(); await loadDailyTasks(); }
    else alert(data.error || 'Submission failed');
  } catch (err) { alert('Network error'); }
});

// ── HELPERS ──
function switchTab(tab) {
  document.querySelectorAll('.ap-nav-item').forEach(n => n.classList.remove('active'));
  document.querySelectorAll('.ap-section').forEach(s => s.classList.remove('active'));
  document.querySelector(`.ap-nav-item[data-tab="${tab}"]`).classList.add('active');
  document.getElementById('sec-' + tab).classList.add('active');
}

function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

function fireConfetti() {
  const container = document.createElement('div');
  container.className = 'ap-confetti';
  document.body.appendChild(container);
  const colors = ['#111','#333','#555','#777','#999','#000','#222','#444'];
  for (let i = 0; i < 25; i++) {
    const piece = document.createElement('div');
    piece.className = 'confetti-piece';
    piece.style.left = Math.random() * 100 + '%';
    piece.style.top = 55 + Math.random() * 30 + '%';
    piece.style.background = colors[Math.floor(Math.random() * colors.length)];
    piece.style.animationDelay = Math.random() * 0.4 + 's';
    piece.style.animationDuration = 1 + Math.random() * 0.8 + 's';
    container.appendChild(piece);
  }
  setTimeout(() => container.remove(), 2500);
}
</script>
