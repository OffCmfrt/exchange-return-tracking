        <span class="period">This Month</span>
        <span class="orders">${c.monthly_uses || 0}</span>
        <span class="commission">${fmt(c.monthly_commission)}</span>
      </div>
      <div class="ap-commission-row">
        <span class="period">All Time</span>
        <span class="orders">${c.total_uses || 0}</span>
        <span class="commission">${fmt(c.total_commission)}</span>
      </div>
