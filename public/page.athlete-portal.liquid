      <div class="weekly-icon"><svg><use href="#icon-trophy"/></svg></div>
      <h2>${esc(c.title)}</h2>
      <p>${esc(c.description || '')}</p>
      ${c.instructions ? '<p style="font-size:.65rem;opacity:.7;margin-top:.4rem">'+esc(c.instructions)+'</p>' : ''}
      <div class="rewards-row"><span>+${c.reward_xp||0} XP</span><span>+${c.reward_coins||0} coins</span>${c.reward_badge ? '<span>Badge</span>' : ''}</div>
      <div class="countdown">${daysLeft} day${daysLeft!==1?'s':''} left</div>
    </div>
    ${entryHtml}
    <div class="ap-weekly-lb-header"><h3>Challenge Leaderboard</h3><span id="weeklyEntryCount"></span></div>
    <div id="weeklyLbList"><div class="ap-empty"><p>Loading...</p></div></div>`;

  loadWeeklyLeaderboard(c.id);
