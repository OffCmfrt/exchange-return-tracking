      <label>Caption</label>
      <textarea id="submitCaption" placeholder="What did you post about?"></textarea>
    </div>
    <div class="ap-input-group">
      <label style="display:flex;align-items:center;gap:.4rem;cursor:pointer;font-size:.75rem;text-transform:none;letter-spacing:0">
        <input type="checkbox" id="submitDisclosure"> #ad or sponsored tag included
      </label>
    </div>
    <div class="ap-modal-actions">
      <button class="ap-btn ap-btn-outline" onclick="closeModal()">Cancel</button>
      <button class="ap-btn" id="submitBtn">Submit</button>
    </div>
  </div>
</div>

<script>
const API = 'https://exchange-return-tracking.onrender.com/api/athlete';
let S = { token: null, athlete: null, dailyTasks: null, weekly: null, streak: null, badges: [], leaderboard: [], weeklyLb: [], coupon: null };

// ── PRODUCT DEFINITIONS (level-gated) ──
const PRODUCTS = [
  { id: 'tee-classic', name: 'Classic Comfort Tee', desc: 'Our signature everyday tee', level: 1, icon: 'icon-shirt' },
  { id: 'cap-og', name: 'OG Logo Cap', desc: 'Structured fit, embroidered logo', level: 2, icon: 'icon-cap' },
  { id: 'socks-pack', name: 'Comfort Socks 3-Pack', desc: 'Cushioned ankle socks', level: 3, icon: 'icon-socks' },
  { id: 'hoodie-essentials', name: 'Essentials Hoodie', desc: 'Heavyweight fleece pullover', level: 4, icon: 'icon-shirt' },
  { id: 'headphones-case', name: 'Travel Pouch', desc: 'Compact carry-all pouch', level: 5, icon: 'icon-bag' },
  { id: 'headphones-pro', name: 'Pro Headphones', desc: 'Wireless over-ear, limited edition', level: 7, icon: 'icon-headphones' },
];

// ── INIT ─
document.addEventListener('DOMContentLoaded', () => {
  const saved = sessionStorage.getItem('ap_token');
  if (saved) { S.token = saved; loadAll(); }
  else { showAuth(); }
  setupNav();
  setupAuth();
  setupLbTabs();
});

function showAuth() {
  document.getElementById('loading').classList.add('out');
  document.getElementById('auth').style.display = 'flex';
}

function setupAuth() {
  document.getElementById('authForm').addEventListener('submit', async e => {
    e.preventDefault();
    S.token = document.getElementById('tokenInput').value.trim();
    sessionStorage.setItem('ap_token', S.token);
    await loadAll();
  });
}

async function loadAll() {
  try {
    const res = await fetch(`${API}/${S.token}/progress`);
    if (!res.ok) throw new Error('Invalid token');
    const data = await res.json();
    if (!data.success) throw new Error(data.error || 'Failed');
    S.athlete = data.data;
    showShell();
    loadDailyTasks();
    loadWeekly();
    loadStreak();
    loadBadges();
    loadLeaderboard('all_time');
    renderProducts();
    loadCoupon();
  } catch (err) {
    sessionStorage.removeItem('ap_token');
    S.token = null;
    document.getElementById('authErr').textContent = 'Invalid or expired access link';
    showAuth();
  }
}

function showShell() {
  const a = S.athlete;
  document.getElementById('auth').style.display = 'none';
  document.getElementById('loading').classList.add('out');
  document.getElementById('shell').classList.add('active');

  document.getElementById('headerLevel').textContent = a.level?.display_number ?? '—';
  document.getElementById('headerName').textContent = a.name || 'Athlete';

  renderXpRing();
  document.getElementById('homeStreak').textContent = '0';
  document.getElementById('homeStanding').textContent = Math.round(a.standing_score || 0);
  document.getElementById('homeCoins').textContent = (a.coin_balance || 0).toLocaleString();
}

function renderXpRing() {
  const a = S.athlete;
  const xp = a.xp_total || 0;
  const nextMinXp = a.next_level?.min_xp || xp + 100;
  const prevMinXp = a.level?.min_xp || 0;
  const range = nextMinXp - prevMinXp;
  const progress = xp - prevMinXp;
  const pct = Math.min(100, Math.max(0, (progress / range) * 100));
  const circumference = 376.99;
  const offset = circumference - (pct / 100) * circumference;

  const levelName = a.level?.display_name || 'Unranked';
  document.getElementById('homeLevelName').textContent = 'LVL ' + (a.level?.display_number || '—');
  document.getElementById('homeXp').textContent = xp.toLocaleString();
  document.getElementById('homeXpNext').textContent = '/ ' + nextMinXp.toLocaleString();
  document.getElementById('xpLevelLabel').textContent = levelName;
  setTimeout(() => {
    document.getElementById('xpArc').style.strokeDashoffset = offset;
    document.getElementById('xpBarFill').style.width = pct.toFixed(1) + '%';
  }, 300);
  document.getElementById('xpProgress').textContent = pct.toFixed(0) + '%';
  document.getElementById('xpToNext').textContent = (nextMinXp - xp).toLocaleString() + ' XP to go';
}

// ── NAV ──
function setupNav() {
  document.querySelectorAll('.ap-nav-item').forEach(item => {
    item.addEventListener('click', () => {
      document.querySelectorAll('.ap-nav-item').forEach(n => n.classList.remove('active'));
      document.querySelectorAll('.ap-section').forEach(s => s.classList.remove('active'));
      item.classList.add('active');
      document.getElementById('sec-' + item.dataset.tab).classList.add('active');
    });
  });
}

// ── DAILY TASKS ──
async function loadDailyTasks() {
  try {
    const res = await fetch(`${API}/${S.token}/daily-tasks`);
    const data = await res.json();
    S.dailyTasks = data.data || {};
    renderHomeTasks();
    renderFullTasks();
  } catch (err) { console.error('Daily tasks load:', err); }
}

function renderHomeTasks() {
  const scroll = document.getElementById('homeTasksScroll');
  const tasks = S.dailyTasks?.tasks || [];
  const picks = S.dailyTasks?.picks || [];
  const maxPicks = S.dailyTasks?.maxPicks || 5;
  document.getElementById('homeTaskCount').textContent = picks.length + '/' + maxPicks + ' picked';

  if (tasks.length === 0) {
    scroll.innerHTML = '<div class="ap-empty" style="min-width:100%"><div class="empty-icon"><svg><use href="#icon-tasks"/></svg></div><p>No missions available today.<br>Check back tomorrow!</p></div>';
    return;
  }

  scroll.innerHTML = tasks.map(t => {
    let statusClass = 'available', statusText = 'Tap to pick';
    if (t.picked) {
      if (t.pick_status === 'APPROVED') { statusClass = 'completed'; statusText = 'Approved'; }
      else if (t.pick_status === 'SUBMITTED') { statusClass = 'completed'; statusText = 'Submitted'; }
      else { statusClass = 'picked'; statusText = 'Picked'; }
    }
    return `<div class="ap-task-mini" onclick="switchTab('tasks')">
      <div class="task-type"><span class="type-dot"></span>${(t.type||'TASK').replace('_',' ')}</div>
      <div class="task-title">${esc(t.title)}</div>
      <div class="task-rewards"><span>+${t.xp_value||0} XP</span><span>+${t.coin_value||0} coins</span></div>
      <div class="task-status ${statusClass}">${statusText}</div>
    </div>`;
  }).join('');
}

function renderFullTasks() {
  const list = document.getElementById('taskList');
  const tasks = S.dailyTasks?.tasks || [];
  const picks = S.dailyTasks?.picks || [];
  const maxPicks = S.dailyTasks?.maxPicks || 5;
  document.getElementById('taskPickCount').textContent = picks.length + '/' + maxPicks;

  const available = maxPicks - picks.length;
  const badge = document.getElementById('taskBadge');
  if (available > 0 && tasks.length > 0) { badge.style.display = 'flex'; badge.textContent = available; }
  else { badge.style.display = 'none'; }

  if (tasks.length === 0) {
    list.innerHTML = '<div class="ap-empty"><div class="empty-icon"><svg><use href="#icon-tasks"/></svg></div><p>No missions today</p></div>';
    return;
  }

  list.innerHTML = tasks.map(t => {
    let btnHtml = '', statusHtml = '';
    if (t.picked) {
      statusHtml = `<div class="status-badge ${(t.pick_status||'picked').toLowerCase()}">${(t.pick_status||'PICKED').replace(/_/g,' ')}</div>`;
      if (['PICKED','ASSIGNED','IN_PROGRESS','CHANGES_REQUESTED'].includes(t.pick_status)) {
        btnHtml = `<button class="pick-btn" onclick="event.stopPropagation();openSubmit(${t.assignment_id})">Submit</button>`;
      } else {
        btnHtml = `<button class="pick-btn" disabled>Done</button>`;
      }
    } else if (picks.length >= maxPicks) {
      btnHtml = `<button class="pick-btn" disabled>Full</button>`;
    } else {
      btnHtml = `<button class="pick-btn" onclick="event.stopPropagation();pickTask(${t.id})">Pick</button>`;
    }

    return `<div class="ap-task-full">
      <div class="task-left">
        <div class="task-type"><span class="type-dot"></span>${(t.type||'TASK').replace('_',' ')}${t.platform ? ' · '+t.platform : ''}</div>
        <div class="task-title">${esc(t.title)}</div>
        <div class="task-brief">${esc(t.brief_md||t.brief||'')}</div>
        <div class="task-rewards"><span>+${t.xp_value||0} XP</span><span>+${t.coin_value||0} coins</span></div>
      </div>
      <div class="task-right">${btnHtml}${statusHtml}</div>
    </div>`;
  }).join('');
}

async function pickTask(templateId) {
  try {
    const res = await fetch(`${API}/${S.token}/daily-tasks/pick`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ task_template_id: templateId })
    });
    const data = await res.json();
    if (data.success) {
      fireConfetti();
      await loadDailyTasks();
    } else { alert(data.error || 'Could not pick task'); }
  } catch (err) { alert('Network error'); }
}

// ── WEEKLY CHALLENGE ─
async function loadWeekly() {
  try {
    const res = await fetch(`${API}/${S.token}/weekly-challenge`);
    const data = await res.json();
    S.weekly = data.data || {};
    renderHomeWeekly();
