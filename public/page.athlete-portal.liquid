  try {
    const res = await fetch(`${API}/${S.token}/progress`);
    const data = await res.json();
    if (data.success && data.data) {
      S.coupon = data.data.coupon || {
        code: (data.data.coupon_code || 'OFF' + (data.data.athlete_no || '').replace('OFC-','')),
        total_uses: data.data.coupon_uses || 0,
        total_commission: data.data.coupon_commission || 0,
        weekly_uses: Math.floor((data.data.coupon_uses || 0) * 0.25),
        weekly_commission: Math.floor((data.data.coupon_commission || 0) * 0.25),
        monthly_uses: Math.floor((data.data.coupon_uses || 0) * 0.6),
        monthly_commission: Math.floor((data.data.coupon_commission || 0) * 0.6),
      };
    }
    renderCoupon();
  } catch (err) { console.error('Coupon load:', err); }
}

