@media(max-width:360px){.ap-stat .stat-value{font-size:1.7rem}.ap-weekly-idle p{font-size:1.18rem}}

/* TRAINING FILM — compact, background-merged Home footer */
.ap-training-film{position:relative;height:198px;margin:2.8rem -1rem 0;overflow:hidden;background:#080808;color:#fff;isolation:isolate;border-top:1px solid #111;border-bottom:1px solid #111}
.ap-training-film::before{content:'';position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,rgba(0,0,0,.88) 0%,rgba(0,0,0,.46) 48%,rgba(0,0,0,.78) 100%),linear-gradient(0deg,#080808 0%,transparent 25%,transparent 72%,#080808 100%)}
.ap-training-film::after{content:'';position:absolute;inset:0;z-index:2;pointer-events:none;opacity:.32;background-image:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:100% 34px,34px 100%;mix-blend-mode:screen}
.ap-training-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.22) brightness(.58);opacity:.78;transform:scale(1.04);z-index:0}
.ap-training-copy{position:absolute;z-index:3;left:1rem;right:1rem;bottom:1rem;display:flex;align-items:end;justify-content:space-between;gap:1rem}.ap-training-copy small{display:block;font-size:.46rem;font-weight:900;letter-spacing:.16em;color:#bababa;margin-bottom:.35rem}.ap-training-copy h2{font-family:var(--display);font-size:1.45rem;line-height:.88;letter-spacing:-.05em}.ap-training-copy span{font-size:.46rem;font-weight:900;letter-spacing:.13em;border:1px solid rgba(255,255,255,.5);padding:.32rem .4rem;white-space:nowrap}.ap-training-film .film-rule{position:absolute;z-index:3;top:1rem;left:1rem;right:1rem;height:1px;background:rgba(255,255,255,.38)}
@media(min-width:500px){.ap-training-film{margin-left:-1.25rem;margin-right:-1.25rem;height:235px}}
@media(prefers-reduced-motion:reduce){.ap-training-video{display:none}}
</style>
</head>
