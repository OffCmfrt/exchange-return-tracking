function renderWeeklyTab() {
  const el = document.getElementById('weeklyContent');
  const c = S.weekly?.challenge;
  const entry = S.weekly?.entry;

  if (!c) {
    el.innerHTML = '<div class="ap-empty"><div class="empty-icon"><svg><use href="#icon-trophy"/></svg></div><p>No active challenge this week.<br>Stay tuned!</p></div>';
    return;
  }

  const daysLeft = Math.ceil((new Date(c.week_end) - Date.now()) / 86400000);
  let entryHtml = '';
  if (entry) {
    entryHtml = `<div class="ap-weekly-entry">
      <h3>Your Entry</h3>
      <p style="font-size:.72rem;color:var(--text-2);margin-bottom:.4rem">${esc(entry.submission_url||'')}</p>
      <span style="font-size:.65rem;font-weight:700;color:var(--text-2)">${entry.status}</span>
    </div>`;
  } else {
    entryHtml = `<div class="ap-weekly-entry">
      <h3>Submit Your Entry</h3>
      <div class="ap-input-group"><label>Post URL</label>
        <input type="url" class="ap-input" id="weeklyUrl" placeholder="https://instagram.com/..."></div>
      <div class="ap-input-group"><label>Caption</label>
        <textarea id="weeklyCaption" placeholder="Describe your entry..." style="min-height:55px"></textarea></div>
      <div class="ap-input-group"><label style="display:flex;align-items:center;gap:.4rem;cursor:pointer;font-size:.75rem;text-transform:none;letter-spacing:0">
        <input type="checkbox" id="weeklyDisclosure"> #ad or sponsored tag included</label></div>
      <button class="ap-btn" onclick="submitWeekly()">Submit Entry</button>
