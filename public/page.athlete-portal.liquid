{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Athlete Portal — Offcomfrt</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#ffffff;--surface:#f4f4f4;--surface-2:#eaeaea;--surface-3:#ddd;
  --border:#d5d5d5;--border-2:#bbb;
  --text:#0a0a0a;--text-2:#444;--muted:#777;--faint:#aaa;
  --accent:#000;--accent-light:#f0f0f0;
  --radius:16px;--radius-sm:12px;--radius-xs:8px;
  --shadow:0 1px 4px rgba(0,0,0,.06);
  --shadow-md:0 4px 16px rgba(0,0,0,.1);
  --shadow-lg:0 8px 32px rgba(0,0,0,.14);
  --transition:.2s cubic-bezier(.4,0,.2,1);
  --font:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
  --display:'Playfair Display',Georgia,serif;
  --nav-height:60px;
}
html,body{background:var(--bg);color:var(--text);font-family:var(--font);
  min-height:100vh;-webkit-font-smoothing:antialiased;overflow-x:hidden;
  padding-bottom:var(--nav-height);font-weight:500}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes scaleIn{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes confetti{0%{transform:translateY(0) rotate(0) scale(1)}100%{transform:translateY(-300px) rotate(720deg) scale(0);opacity:0}}
@keyframes popIn{0%{transform:scale(0);opacity:0}60%{transform:scale(1.12)}100%{transform:scale(1);opacity:1}}
@keyframes bounceIn{0%{transform:scale(.3);opacity:0}50%{transform:scale(1.06)}100%{transform:scale(1);opacity:1}}
@keyframes pulse-ring{0%{transform:scale(.9);opacity:1}100%{transform:scale(1.35);opacity:0}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}

/* LOADING */
.ap-loading{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:1rem;z-index:9999;transition:opacity .4s}
.ap-loading.out{opacity:0;pointer-events:none}
.ap-spinner{width:32px;height:32px;border:3px solid var(--border);border-top-color:var(--text);
  border-radius:50%;animation:spin .6s linear infinite}
.ap-loading p{font-size:.6rem;letter-spacing:.3em;text-transform:uppercase;color:var(--muted);font-weight:700}

/* AUTH */
.ap-auth{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;
  justify-content:center;padding:1.5rem;z-index:800}
.ap-auth-card{background:var(--bg);width:100%;max-width:380px;padding:2.5rem 1.5rem;
  text-align:center;animation:fadeUp .5s ease both;border:2px solid var(--border);border-radius:var(--radius)}
.ap-auth-logo{font-family:var(--display);font-size:2rem;font-weight:900;letter-spacing:.08em;margin-bottom:.4rem}
.ap-auth-sub{font-size:.78rem;color:var(--muted);margin-bottom:2rem;line-height:1.5;font-weight:500}
.ap-input-group{text-align:left;margin-bottom:1rem}
.ap-input-group label{display:block;font-size:.6rem;font-weight:800;color:var(--text);
  margin-bottom:.4rem;text-transform:uppercase;letter-spacing:.1em}
.ap-input{width:100%;background:var(--surface);border:2px solid var(--border);color:var(--text);
  padding:.85rem 1rem;font-size:.88rem;font-family:var(--font);border-radius:var(--radius-sm);
  outline:none;transition:all var(--transition);font-weight:500}
.ap-input:focus{border-color:var(--text);box-shadow:0 0 0 3px rgba(0,0,0,.06)}
.ap-input::placeholder{color:var(--faint)}
.ap-btn{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;
  background:var(--accent);color:#fff;border:none;padding:.9rem 1.2rem;
  font-size:.75rem;font-weight:800;letter-spacing:.04em;font-family:var(--font);
  cursor:pointer;border-radius:var(--radius-sm);transition:all var(--transition);width:100%;
  text-transform:uppercase}
.ap-btn:hover{transform:translateY(-1px);box-shadow:var(--shadow-md)}
.ap-btn:active{transform:translateY(0)}
.ap-btn-outline{background:transparent;color:var(--text);border:2px solid var(--border)}
.ap-btn-outline:hover{border-color:var(--text);background:var(--text);color:#fff}
.ap-auth-err{font-size:.72rem;color:var(--text-2);margin-top:.6rem;min-height:1.2em;font-weight:600}

/* SHELL */
.ap-shell{display:none;min-height:100vh}
.ap-shell.active{display:block;animation:fadeIn .3s ease}

/* TOP HEADER */
.ap-header{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.98);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-bottom:2px solid var(--text);padding:.65rem 1rem;
  display:flex;align-items:center;justify-content:space-between}
.ap-header-logo{display:flex;align-items:center}
.ap-header-logo svg{height:22px;width:auto}
.ap-header-right{display:flex;align-items:center;gap:.6rem}
.ap-header-level{width:28px;height:28px;border-radius:50%;background:var(--text);color:#fff;
  display:flex;align-items:center;justify-content:center;font-weight:900;font-size:.7rem;
  border:2px solid var(--text)}
.ap-header-name{font-size:.7rem;font-weight:700;color:var(--text-2)}

/* BOTTOM NAV */
.ap-bottom-nav{position:fixed;bottom:0;left:0;right:0;z-index:200;
  background:rgba(255,255,255,.98);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-top:2px solid var(--text);display:flex;height:var(--nav-height);
  padding-bottom:env(safe-area-inset-bottom)}
.ap-nav-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:.1rem;cursor:pointer;color:var(--faint);transition:all var(--transition);
  position:relative;-webkit-tap-highlight-color:transparent}
.ap-nav-item.active{color:var(--text)}
.ap-nav-item.active .nav-icon{transform:scale(1.1)}
.ap-nav-item .nav-icon{line-height:1;transition:transform .25s ease}
.ap-nav-item .nav-icon svg{width:22px;height:22px;stroke-width:2}
.ap-nav-item .nav-label{font-size:.52rem;font-weight:800;letter-spacing:.03em;text-transform:uppercase}
.ap-nav-badge{position:absolute;top:1px;right:calc(50% - 18px);
  background:var(--text);color:#fff;font-size:.48rem;font-weight:800;
  min-width:14px;height:14px;border-radius:7px;display:flex;align-items:center;
  justify-content:center;padding:0 2px;animation:bounceIn .3s ease both}

/* MAIN CONTENT */
.ap-main{padding:.75rem;max-width:560px;margin:0 auto}
.ap-section{display:none;animation:fadeUp .35s ease both}
.ap-section.active{display:block}

/* CARDS */
.ap-card{background:var(--bg);border:2px solid var(--border);border-radius:var(--radius);
  padding:1rem;margin-bottom:.6rem;box-shadow:var(--shadow);transition:all var(--transition)}

/* XP PROGRESS — compact hero */
.ap-xp-card{display:flex;align-items:center;gap:1rem;padding:1rem 1.1rem}
.ap-xp-ring{width:90px;height:90px;flex-shrink:0;position:relative}
.ap-xp-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.ap-xp-ring circle{fill:none;stroke-width:6}
.ap-xp-ring .track{stroke:var(--surface-2)}
.ap-xp-ring .fill{stroke:var(--text);stroke-linecap:round;
  transition:stroke-dashoffset 1.2s cubic-bezier(.4,0,.2,1)}
.ap-xp-center{position:absolute;inset:0;display:flex;flex-direction:column;
  align-items:center;justify-content:center}
.ap-xp-center .level-name{font-size:.48rem;font-weight:800;text-transform:uppercase;
  letter-spacing:.1em;color:var(--muted);margin-bottom:.05rem}
.ap-xp-center .xp-value{font-size:1.2rem;font-weight:900;letter-spacing:-.02em;line-height:1}
.ap-xp-center .xp-next{font-size:.48rem;color:var(--muted);margin-top:.1rem;font-weight:600}
.ap-xp-info{flex:1;min-width:0}
.ap-xp-info .xp-level-name{font-size:.65rem;font-weight:800;text-transform:uppercase;
  letter-spacing:.08em;color:var(--muted);margin-bottom:.2rem}
.ap-xp-info .xp-bar{height:6px;background:var(--surface-2);border-radius:3px;overflow:hidden;margin-bottom:.4rem}
.ap-xp-info .xp-bar-fill{height:100%;background:var(--text);border-radius:3px;
  transition:width 1s cubic-bezier(.4,0,.2,1)}
.ap-xp-info .xp-meta{display:flex;justify-content:space-between;
  font-size:.58rem;color:var(--muted);font-weight:700}

/* STATS ROW */
.ap-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-bottom:.6rem}
.ap-stat{background:var(--bg);border:2px solid var(--border);border-radius:var(--radius-sm);
  padding:.75rem .5rem;text-align:center;box-shadow:var(--shadow);transition:all var(--transition)}
.ap-stat:hover{border-color:var(--border-2);transform:translateY(-1px)}
.ap-stat .stat-icon{margin-bottom:.15rem}
.ap-stat .stat-icon svg{width:20px;height:20px;stroke-width:2}
.ap-stat .stat-value{font-size:1.1rem;font-weight:900;letter-spacing:-.02em}
.ap-stat .stat-label{font-size:.48rem;color:var(--muted);font-weight:800;
  text-transform:uppercase;letter-spacing:.05em;margin-top:.1rem}

/* SECTION HEADERS */
.ap-section-header{display:flex;justify-content:space-between;align-items:center;
  margin-bottom:.5rem;margin-top:.75rem}
.ap-section-header h2{font-size:.82rem;font-weight:900;letter-spacing:-.01em}
.ap-section-header .count{font-size:.6rem;color:var(--muted);font-weight:700}

/* DAILY TASK CARDS (horizontal scroll on home) */
.ap-tasks-scroll{display:flex;gap:.5rem;overflow-x:auto;padding:.2rem 0 .4rem;
  -webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory;scrollbar-width:none}
.ap-tasks-scroll::-webkit-scrollbar{display:none}
.ap-task-mini{min-width:170px;max-width:195px;background:var(--bg);border:2px solid var(--border);
  border-radius:var(--radius-sm);padding:.85rem;scroll-snap-align:start;
  box-shadow:var(--shadow);flex-shrink:0;cursor:pointer;transition:all var(--transition)}
.ap-task-mini:hover{box-shadow:var(--shadow-md);transform:translateY(-2px);border-color:var(--text)}
.ap-task-mini .task-type{font-size:.48rem;font-weight:800;text-transform:uppercase;
  letter-spacing:.08em;color:var(--muted);margin-bottom:.3rem;
  display:flex;align-items:center;gap:.25rem}
.ap-task-mini .task-type .type-dot{width:5px;height:5px;border-radius:50%;background:var(--text)}
.ap-task-mini .task-title{font-size:.75rem;font-weight:800;margin-bottom:.4rem;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.3}
.ap-task-mini .task-rewards{display:flex;gap:.5rem;font-size:.6rem;font-weight:800;color:var(--text)}
.ap-task-mini .task-status{margin-top:.4rem;font-size:.48rem;font-weight:800;
  text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
.ap-task-mini .task-status.picked{color:var(--text)}
.ap-task-mini .task-status.completed{color:var(--text-2)}

/* FULL TASK CARDS (tasks tab) */
.ap-task-full{background:var(--bg);border:2px solid var(--border);border-radius:var(--radius);
  padding:.85rem 1rem;margin-bottom:.5rem;box-shadow:var(--shadow);
  display:grid;grid-template-columns:1fr auto;gap:.6rem;align-items:center;
  cursor:pointer;transition:all var(--transition)}
.ap-task-full:hover{box-shadow:var(--shadow-md);border-color:var(--border-2)}
.ap-task-full .task-type{font-size:.48rem;font-weight:800;text-transform:uppercase;
  letter-spacing:.08em;color:var(--muted);margin-bottom:.2rem;
  display:flex;align-items:center;gap:.25rem}
.ap-task-full .task-title{font-size:.82rem;font-weight:800;margin-bottom:.15rem}
.ap-task-full .task-brief{font-size:.7rem;color:var(--text-2);line-height:1.3;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:.4rem}
.ap-task-full .task-rewards{display:flex;gap:.6rem;font-size:.65rem;font-weight:800;color:var(--text)}
.ap-task-full .task-right{text-align:center}
.ap-task-full .task-right .pick-btn{background:var(--text);color:#fff;border:none;
  padding:.5rem 1rem;border-radius:var(--radius-xs);font-size:.65rem;font-weight:800;
  font-family:var(--font);cursor:pointer;transition:all var(--transition);text-transform:uppercase;
  letter-spacing:.03em}
.ap-task-full .task-right .pick-btn:hover{transform:scale(1.04);box-shadow:var(--shadow-md)}
.ap-task-full .task-right .pick-btn:disabled{background:var(--faint);cursor:default;transform:none}
.ap-task-full .task-right .status-badge{font-size:.48rem;font-weight:800;
  text-transform:uppercase;letter-spacing:.05em;padding:.25rem .5rem;
  border-radius:4px;margin-top:.2rem;display:inline-block}
.status-badge.assigned{background:var(--surface-2);color:var(--text-2)}
.status-badge.in_progress{background:var(--surface-2);color:var(--text-2)}
.status-badge.submitted{background:var(--surface-2);color:var(--text-2)}
.status-badge.approved{background:var(--text);color:#fff}
.status-badge.picked{background:var(--surface-2);color:var(--text)}

/* WEEKLY CHALLENGE */
.ap-weekly-hero{background:linear-gradient(135deg,#0a0a0a 0%,#2a2a2a 100%);color:#fff;
  border-radius:var(--radius);padding:1.5rem;margin-bottom:.6rem;text-align:center;
  position:relative;overflow:hidden;border:2px solid var(--text)}
.ap-weekly-hero::before{content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 30% 50%,rgba(255,255,255,.04) 0%,transparent 60%)}
.ap-weekly-hero .weekly-icon{margin-bottom:.4rem;animation:float 3s ease-in-out infinite}
.ap-weekly-hero .weekly-icon svg{width:36px;height:36px}
.ap-weekly-hero h2{font-family:var(--display);font-size:1.1rem;font-weight:900;margin-bottom:.2rem;letter-spacing:.02em}
.ap-weekly-hero p{font-size:.7rem;opacity:.75;line-height:1.4;margin-bottom:.6rem;font-weight:500}
.ap-weekly-hero .rewards-row{display:flex;justify-content:center;gap:.8rem;
  font-size:.7rem;font-weight:800;letter-spacing:.03em}
.ap-weekly-hero .countdown{margin-top:.6rem;font-size:.55rem;opacity:.6;
  font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.ap-weekly-entry{background:var(--bg);border:2px solid var(--border);
  border-radius:var(--radius);padding:1rem;margin-bottom:.6rem;box-shadow:var(--shadow)}
.ap-weekly-entry h3{font-size:.75rem;font-weight:800;margin-bottom:.6rem;letter-spacing:.01em}

/* LEADERBOARD */
.ap-podium{display:flex;align-items:flex-end;justify-content:center;gap:.4rem;
  margin-bottom:1rem;padding:0 .3rem}
.ap-podium-item{text-align:center;flex:1;max-width:110px}
.ap-podium-item .podium-rank{font-size:1.2rem;font-weight:900;margin-bottom:.15rem;color:var(--text);
  font-family:var(--display)}
.ap-podium-item .podium-name{font-size:.7rem;font-weight:800;margin-bottom:.05rem;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ap-podium-item .podium-xp{font-size:.55rem;color:var(--muted);font-weight:700}
.ap-podium-item .podium-bar{border-radius:var(--radius-xs) var(--radius-xs) 0 0;
  margin-top:.3rem;transition:height .5s cubic-bezier(.4,0,.2,1)}
.ap-podium-item:nth-child(2) .podium-bar{height:70px;background:var(--text)}
.ap-podium-item:nth-child(1) .podium-bar{height:52px;background:var(--surface-3)}
.ap-podium-item:nth-child(3) .podium-bar{height:40px;background:var(--surface-3)}
.ap-lb-row{display:flex;align-items:center;gap:.6rem;padding:.7rem .8rem;
  border-bottom:1px solid var(--border);transition:all var(--transition)}
.ap-lb-row:hover{background:var(--surface)}
.ap-lb-row.self{background:var(--text);color:#fff;border-radius:var(--radius-xs);
  border:2px solid var(--text);margin-bottom:.15rem}
.ap-lb-row.self .ap-lb-name{color:#fff}
.ap-lb-row.self .ap-lb-level{color:rgba(255,255,255,.6)}
.ap-lb-row.self .ap-lb-xp{color:#fff}
.ap-lb-rank{width:24px;font-weight:900;font-size:.8rem;text-align:center;color:var(--muted)}
.ap-lb-info{flex:1}
.ap-lb-name{font-size:.75rem;font-weight:700}
.ap-lb-level{font-size:.55rem;color:var(--muted);font-weight:600}
.ap-lb-xp{font-size:.75rem;font-weight:900}

/* BADGES ROW */
.ap-badges-scroll{display:flex;gap:.4rem;overflow-x:auto;padding:.15rem 0;
  -webkit-overflow-scrolling:touch;scrollbar-width:none}
.ap-badges-scroll::-webkit-scrollbar{display:none}
.ap-badge-item{min-width:56px;text-align:center;flex-shrink:0}
.ap-badge-icon{width:44px;height:44px;border-radius:50%;background:var(--surface);
  border:2px solid var(--border);display:flex;align-items:center;justify-content:center;
  margin:0 auto .15rem;transition:all var(--transition)}
.ap-badge-icon:hover{border-color:var(--text);transform:scale(1.08)}
.ap-badge-icon svg{width:20px;height:20px}
.ap-badge-name{font-size:.45rem;font-weight:700;color:var(--muted);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:56px}

/* WEEKLY LEADERBOARD */
.ap-weekly-lb-header{display:flex;justify-content:space-between;align-items:center;
  margin-bottom:.5rem}
.ap-weekly-lb-header h3{font-size:.75rem;font-weight:800;letter-spacing:.01em}
.ap-weekly-lb-header span{font-size:.6rem;color:var(--muted);font-weight:700}

/* PRODUCTS SECTION */
.ap-product-card{background:var(--bg);border:2px solid var(--border);border-radius:var(--radius);
  padding:.85rem 1rem;margin-bottom:.5rem;box-shadow:var(--shadow);
  display:flex;align-items:center;gap:.8rem;transition:all var(--transition)}
.ap-product-card:hover{box-shadow:var(--shadow-md);border-color:var(--border-2)}
.ap-product-card.locked{opacity:.45}
.ap-product-img{width:50px;height:50px;border-radius:var(--radius-xs);background:var(--surface-2);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;
  border:2px solid var(--border)}
.ap-product-img svg{width:24px;height:24px}
.ap-product-info{flex:1;min-width:0}
.ap-product-info h4{font-size:.78rem;font-weight:800;margin-bottom:.1rem}
.ap-product-info p{font-size:.65rem;color:var(--muted);line-height:1.2;font-weight:500}
.ap-product-lock{font-size:.5rem;font-weight:800;color:var(--muted);
  background:var(--surface);padding:.3rem .6rem;border-radius:20px;white-space:nowrap;
  letter-spacing:.03em;text-transform:uppercase}
.ap-product-lock.unlocked{background:var(--text);color:#fff}

/* COUPONS SECTION */
.ap-coupon-hero{background:var(--text);color:#fff;border-radius:var(--radius);
  padding:1.2rem;margin-bottom:.6rem;text-align:center;border:2px solid var(--text)}
.ap-coupon-code{font-size:1.3rem;font-weight:900;letter-spacing:.12em;margin-bottom:.5rem;
  font-family:'Courier New',monospace}
.ap-coupon-copy{display:inline-flex;align-items:center;gap:.3rem;
  background:rgba(255,255,255,.12);border:1.5px solid rgba(255,255,255,.25);
  color:#fff;padding:.4rem .8rem;border-radius:20px;font-size:.65rem;font-weight:700;
  cursor:pointer;transition:all var(--transition);text-transform:uppercase;letter-spacing:.03em}
.ap-coupon-copy:hover{background:rgba(255,255,255,.22);transform:scale(1.04)}
.ap-coupon-copy svg{width:12px;height:12px}
.ap-coupon-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem;margin-bottom:.6rem}
.ap-coupon-stat{background:var(--bg);border:2px solid var(--border);border-radius:var(--radius-sm);
  padding:.7rem .4rem;text-align:center;box-shadow:var(--shadow);transition:all var(--transition)}
.ap-coupon-stat:hover{border-color:var(--border-2);transform:translateY(-1px)}
.ap-coupon-stat .val{font-size:1rem;font-weight:900}
.ap-coupon-stat .lbl{font-size:.45rem;color:var(--muted);font-weight:800;
  text-transform:uppercase;letter-spacing:.05em;margin-top:.1rem}
.ap-commission-table{background:var(--bg);border:2px solid var(--border);
  border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);margin-bottom:.6rem}
.ap-commission-row{display:grid;grid-template-columns:1fr 1fr 1fr;
  padding:.7rem .8rem;border-bottom:1px solid var(--border);font-size:.7rem}
.ap-commission-row:last-child{border-bottom:none}
.ap-commission-row.header{background:var(--surface);font-weight:800;font-size:.55rem;
  text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.ap-commission-row .period{font-weight:700}
.ap-commission-row .orders{text-align:center;color:var(--text-2);font-weight:600}
.ap-commission-row .commission{text-align:right;font-weight:800}

/* SUBMISSION MODAL */
.ap-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:500;
  display:none;align-items:flex-end;justify-content:center}
.ap-modal-overlay.active{display:flex}
