async function submitWeekly() {
  const c = S.weekly?.challenge;
  if (!c) return;
  const url = document.getElementById('weeklyUrl').value.trim();
  const caption = document.getElementById('weeklyCaption').value.trim();
  const disclosure = document.getElementById('weeklyDisclosure').checked;
  if (!url) return alert('Post URL is required');

  try {
    const res = await fetch(`${API}/${S.token}/weekly-challenge/submit`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ challenge_id: c.id, submission_url: url, caption, disclosure_found: disclosure })
    });
    const data = await res.json();
    if (data.success) { fireConfetti(); await loadWeekly(); }
    else alert(data.error || 'Submission failed');
  } catch (err) { alert('Network error'); }
}

async function loadWeeklyLeaderboard(challengeId) {
  try {
    const res = await fetch(`${API}/${S.token}/weekly-leaderboard${challengeId ? '?challenge_id='+challengeId : ''}`);
    const data = await res.json();
    S.weeklyLb = data.data?.entries || [];
    renderWeeklyLb();
  } catch (err) { console.error('Weekly LB load:', err); }
}

function renderWeeklyLb() {
  const el = document.getElementById('weeklyLbList');
  if (!el) return;
  const entries = S.weeklyLb;
  const countEl = document.getElementById('weeklyEntryCount');
  if (countEl) countEl.textContent = entries.length + ' entries';

  if (entries.length === 0) {
    el.innerHTML = '<div class="ap-empty"><p>No entries yet</p></div>';
    return;
  }

  el.innerHTML = entries.map((e, i) => {
    const isSelf = S.athlete && e.influencer_id === S.athlete.id;
    return `<div class="ap-lb-row${isSelf ? ' self' : ''}">
      <div class="ap-lb-rank">${e.display_rank || i+1}</div>
      <div class="ap-lb-info"><div class="ap-lb-name">${esc(e.athlete?.name||'Unknown')}</div>
        <div class="ap-lb-level">${e.athlete?.level_name||'—'}</div></div>
      <div class="ap-lb-xp">${e.score || '—'}</div>
    </div>`;
  }).join('');
}

