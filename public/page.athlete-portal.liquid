    </div>
    <div class="ap-header-right">
      <span class="ap-header-name" id="headerName">—</span>
      <div class="ap-header-level" id="headerLevel">—</div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="ap-main">
    <!-- ══ HOME ═══ -->
    <div class="ap-section active" id="sec-home">
      <!-- XP Progress (compact row) -->
      <div class="ap-card ap-xp-card">
        <div class="ap-xp-ring">
          <svg viewBox="0 0 140 140">
            <circle class="track" cx="70" cy="70" r="60"/>
            <circle class="fill" id="xpArc" cx="70" cy="70" r="60"
              stroke-dasharray="376.99" stroke-dashoffset="376.99"/>
          </svg>
          <div class="ap-xp-center">
            <div class="level-name" id="homeLevelName">—</div>
            <div class="xp-value" id="homeXp">0</div>
            <div class="xp-next" id="homeXpNext">/ 0 XP</div>
          </div>
        </div>
        <div class="ap-xp-info">
          <div class="xp-level-name" id="xpLevelLabel">—</div>
          <div class="xp-bar"><div class="xp-bar-fill" id="xpBarFill" style="width:0%"></div></div>
          <div class="xp-meta"><span id="xpProgress">0%</span><span id="xpToNext">to next level</span></div>
        </div>
      </div>

      <!-- Stats -->
      <div class="ap-stats">
        <div class="ap-stat">
          <div class="stat-icon"><svg><use href="#icon-flame"/></svg></div>
          <div class="stat-value" id="homeStreak">0</div>
          <div class="stat-label">Day Streak</div>
        </div>
        <div class="ap-stat">
          <div class="stat-icon"><svg><use href="#icon-zap"/></svg></div>
          <div class="stat-value" id="homeStanding">0</div>
          <div class="stat-label">Standing</div>
        </div>
        <div class="ap-stat">
          <div class="stat-icon"><svg><use href="#icon-coin"/></svg></div>
          <div class="stat-value" id="homeCoins">0</div>
          <div class="stat-label">Coins</div>
        </div>
      </div>

      <!-- Daily Tasks Preview -->
      <div class="ap-section-header">
        <h2>Today's Missions</h2>
        <span class="count" id="homeTaskCount">0/5 picked</span>
      </div>
      <div class="ap-tasks-scroll" id="homeTasksScroll">
        <div class="ap-empty" style="min-width:100%"><p>Loading missions...</p></div>
      </div>

      <!-- Weekly Challenge Banner -->
      <div class="ap-section-header">
        <h2>Weekly Challenge</h2>
      </div>
      <div id="homeWeeklyBanner">
        <div class="ap-empty"><p>Loading...</p></div>
      </div>

      <!-- Badges -->
      <div class="ap-section-header">
