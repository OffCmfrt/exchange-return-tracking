{{ 'custom-pages.css' | asset_url | stylesheet_tag }}

<style>
    /* Smart Search Modal Enhancements */
    .search-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(4px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10000;
        padding: 1rem;
    }
    .search-modal-content {
        background: white;
        width: 100%;
        max-width: 800px;
        max-height: 90vh;
        border-radius: var(--radius-lg);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
    .search-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--gray-light);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fff;
    }
    .search-body {
        padding: 0;
        overflow-y: auto;
        flex-grow: 1;
        background: #fdfdfd;
    }
    .search-sticky-top {
        position: sticky;
        top: 0;
        background: #fff;
        padding: 1.5rem 2rem;
        z-index: 10;
        border-bottom: 1px solid var(--gray-light);
    }
    .search-results-container {
        padding: 1.5rem 2rem;
    }
    .search-results-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1.5rem;
    }
    .product-search-card {
        background: white;
        border: 1px solid var(--gray-medium);
        border-radius: var(--radius-md);
        overflow: hidden;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        position: relative;
    }
    .product-search-card:hover {
        transform: translateY(-4px);
        border-color: var(--black);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    .product-search-card img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        background: #f5f5f5;
        border-bottom: 1px solid var(--gray-light);
    }
    .product-search-card .info {
        padding: 1rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.5rem;
    }
    .product-search-card h4 {
        margin: 0;
        font-size: 0.9rem;
        font-weight: 500;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .product-search-card .price-tag {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--black);
    }
    .product-search-card .select-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.03);
        opacity: 0;
        transition: opacity 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .product-search-card:hover .select-overlay {
        opacity: 1;
    }
    .select-badge {
        background: var(--black);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: var(--radius-sm);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transform: translateY(10px);
        transition: transform 0.3s;
    }
    .product-search-card:hover .select-badge {
        transform: translateY(0);
    }
    .section-title {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--gray-dark);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .section-title::after {
        content: '';
        flex-grow: 1;
        height: 1px;
        background: var(--gray-light);
    }
    
    @media (max-width: 600px) {
        .search-results-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
        .search-results-container, .search-sticky-top {
            padding: 1rem;
        }
    }

    /* Size Pills in Search */
    .size-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.75rem;
    }
    .size-pill {
        padding: 4px 10px;
        border: 1px solid var(--gray-medium);
        border-radius: var(--radius-sm);
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.2s ease;
        background: #fff;
        font-weight: 500;
        text-transform: uppercase;
    }
    .size-pill:hover:not(.disabled) {
        border-color: var(--black);
        background: var(--black);
        color: #fff;
    }
    .size-pill.disabled {
        opacity: 0.4;
        cursor: not-allowed;
        background: var(--gray-light);
    }

    /* Change Product Button - Premium Style */
    .btn-change-product {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: var(--white);
        border: 1px solid var(--black);
        color: var(--black);
        padding: 7px 15px;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        border-radius: 2px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        margin-top: 0.8rem;
    }
    .btn-change-product:hover {
        background: var(--black);
        color: var(--white);
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .btn-change-product svg {
        transition: transform 0.4s ease;
    }
    .btn-change-product:hover svg {
        transform: rotate(180deg);
    }
</style>

<div class="page-width" style="padding: 3rem 1rem;">
    <!-- Step Bar (Initially Hidden) -->
    <div id="stepBarContainer" class="container container-wide hidden" style="padding-bottom: 0;">
        <div class="step-progress">
            <div class="step-progress-item active" id="step1">
                <div class="step-circle">1</div>
                <span class="step-label">Select Items</span>
            </div>
            <div class="step-progress-item" id="step2">
                <div class="step-circle">2</div>
                <span class="step-label">Exchange Details</span>
            </div>
            <div class="step-progress-item" id="step3">
                <div class="step-circle">3</div>
                <span class="step-label">Pay & Submit</span>
            </div>
        </div>
    </div>

    <!-- Lookup Container (Centered, Narrow) -->
    <div id="lookupContainer" class="container container-narrow">
        <a href="{{ routes.root_url }}" class="back-arrow">Back to Store</a>

        <div class="header">
            <h1>Exchanges</h1>
            <p>Enter your order details to initiate an exchange request</p>
        </div>

        <div id="alertContainer"></div>

        <!-- Step 1: Order Lookup -->
        <div id="lookupSection" class="card">
            <h2 style="font-size: 1.25rem; font-weight: 400; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1.5rem; text-align: center;">
                Order Lookup</h2>

            <form id="lookupForm">
                <div class="form-group">
                    <label for="orderNumber">Order Number</label>
                    <input type="text" id="orderNumber" name="orderNumber" placeholder="#1234" required>
                </div>

                <div class="form-group">
                    <label for="email">Email or Phone</label>
                    <input type="text" id="email" name="email" placeholder="Enter email or phone number" required>
                </div>

                <button type="submit" class="btn btn-primary btn-block" id="lookupBtn">
                    <span id="lookupBtnText">Check Order</span>
                    <span id="lookupSpinner" class="spinner hidden"></span>
                </button>
            </form>

            <p style="margin-top: 1rem; font-size: 0.85rem; color: var(--gray-dark); text-align: center;">
                Track your order by entering the Order number and email or phone number
            </p>
        </div>
    </div>

    <!-- Main Flow Container (Wide) -->
    <div id="mainContainer" class="container container-wide hidden">
        <div id="alertContainerMain"></div>

        <!-- Step 2: Select Items to Exchange -->
        <div id="exchangeSection">
            <div class="order-details">
                <div class="order-header">
                    <h2>Choose items to exchange</h2>
                    <span class="order-number" id="displayOrderNumber"></span>
                </div>

                <div id="orderInfo" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                    <!-- Order info will be populated here -->
                </div>

                <div id="productGrid" class="product-grid">
                    <!-- Products will be populated here -->
                </div>
            </div>

            <div class="card" style="max-width: 800px; margin: 0 auto;">
                <h2 style="font-size: 1.25rem; font-weight: 400; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1.5rem;">
                    Exchange Details</h2>

                <form id="exchangeForm">
                    <div class="form-group">
                        <label for="exchangeReason">Reason for Exchange *</label>
                        <select id="exchangeReason" name="exchangeReason" required>
                            <option value="">Select a reason</option>
                            <option value="size">Wrong Size</option>
                            <option value="color">Different Color Preference</option>
                            <option value="defective">Defective/Damaged Product</option>
                            <option value="wrong_item">Wrong Item Received</option>
                            <option value="other">Other</option>
                        </select>
                    </div>

                    <div id="replacementSection" class="hidden">
                        <h3 style="font-size: 1rem; font-weight: 400; text-transform: uppercase; letter-spacing: 0.5px; margin: 1.5rem 0 1rem;">
                            Select Replacement</h3>
                        <div id="replacementOptions"></div>
                    </div>

                    <div class="form-group">
                        <label for="exchangeComments">Additional Comments</label>
                        <textarea id="exchangeComments" name="exchangeComments" placeholder="Please provide any additional details..."></textarea>
                        <p style="font-size: 0.8rem; color: var(--gray-dark); margin-top: 0.5rem;" id="commentHint">
                            Provide details about your exchange
                        </p>
                    </div>

                    <div class="form-group">
                        <label for="exchangeImages">Upload Images (Required for Damaged Product)</label>
                        <input type="file" id="exchangeImages" name="exchangeImages" accept="image/*" multiple>
                        <p style="font-size: 0.8rem; color: var(--gray-dark); margin-top: 0.5rem;" id="imageHint">
                            Upload photos if the product is damaged or defective
                        </p>
                    </div>

                    <div class="form-group">
                        <label>Shipping Address</label>
                        <div style="background: var(--gray-light); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 0.5rem;" id="currentAddress">
                            <!-- Address will be populated here -->
                        </div>
                        <div class="checkbox-wrapper">
                            <input type="checkbox" id="changeAddress" onchange="toggleAddressChange()">
                            <label for="changeAddress">Ship to a different address</label>
                        </div>
                    </div>

                    <div id="newAddressSection" class="hidden">
                        <div class="form-group">
                            <label for="newAddress">New Address *</label>
                            <textarea id="newAddress" name="newAddress" placeholder="Enter complete address"></textarea>
                        </div>
                        <div class="form-group">
                            <label for="newCity">City *</label>
                            <input type="text" id="newCity" name="newCity" placeholder="City">
                        </div>
                        <div class="form-group">
                            <label for="newPincode">Pincode *</label>
                            <input type="text" id="newPincode" name="newPincode" placeholder="Pincode">
                        </div>
                    </div>

                    <div style="background: var(--gray-light); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
                        <p style="font-size: 0.9rem; margin-bottom: 0.5rem;"><strong>What happens next?</strong></p>
                        <ol style="font-size: 0.85rem; color: var(--gray-dark); padding-left: 1.25rem;">
                            <li>Shiprocket will schedule a pickup from your address</li>
                            <li>Product will be picked up and delivered to us</li>
                            <li>We'll inspect the product condition</li>
                            <li>Once approved, replacement item will be shipped to you</li>
                        </ol>
                    </div>


                    <!-- Video Recording Notice -->
                    <div style="display: flex; align-items: flex-start; gap: 0.875rem; padding: 1rem 1.125rem; background: #fafaf9; border-left: 3px solid #dc2626; border-radius: 0 4px 4px 0; margin-bottom: 1.5rem;">
                        <span style="font-size: 1.1rem; line-height: 1; flex-shrink: 0; margin-top: 1px;">📹</span>
                        <p style="margin: 0; font-size: 0.83rem; color: #44403c; line-height: 1.55;">
                            <span style="display: block; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 0.72rem; color: #991b1b; margin-bottom: 0.2rem;">Video Required at Pickup</span>
                            Recording a video while handing the parcel to the delivery partner is <strong>mandatory</strong>. Disputes without video evidence cannot be processed.
                        </p>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block" id="submitBtn">
                        <span id="submitBtnText">Submit Exchange Request</span>
                        <span id="submitSpinner" class="spinner hidden"></span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Success Section -->
        <div id="successSection" class="hidden card success-modal" style="max-width: 600px; margin: 0 auto;">
            <div class="success-icon">✓</div>
            <h2 style="font-size: 1.5rem; font-weight: 400; margin-bottom: 1rem; text-transform: uppercase;">Exchange Request Submitted</h2>
            <p style="color: var(--gray-dark); margin-bottom: 1.5rem;">
                Your exchange request has been submitted successfully. Shiprocket pickup will be scheduled shortly.
            </p>
            <div style="background: var(--gray-light); padding: 1.5rem; border-radius: var(--radius-md); margin-bottom: 1.5rem;">
                <p style="font-size: 0.85rem; color: var(--gray-dark); margin-bottom: 0.5rem;">Request ID</p>
                <p style="font-size: 1.5rem; font-weight: 500; letter-spacing: 2px;" id="requestId"></p>
            </div>
            <p style="font-size: 0.9rem; margin-bottom: 1.5rem;">
                Save this Request ID to track your exchange status
            </p>
            <a href="/pages/track-request" class="btn btn-secondary">Track Request</a>
            <a href="{{ routes.root_url }}" class="btn btn-primary" style="margin-left: 1rem;">Back to Store</a>
        </div>
    </div>
</div>

<!-- Search Modal -->
<div id="searchModal" class="search-modal hidden">
    <div class="search-modal-content">
        <div class="search-header">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 500; text-transform: uppercase; letter-spacing: 1px;">Change Product</h3>
            <button type="button" onclick="closeSearchModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--gray-dark);">&times;</button>
        </div>
        <div class="search-body">
            <div class="search-sticky-top">
                <div class="search-input-wrapper">
                    <input type="text" id="productSearchInput" placeholder="Search by name or keyword..." oninput="debounceSearch()" autocomplete="off">
                    <div id="productSearchSpinner" class="spinner hidden" style="position: absolute; right: 1rem; top: 50%; margin-top: -10px;"></div>
                </div>
            </div>
            <div class="search-results-container">
                <div id="searchSectionTitle" class="section-title">Recommended Products</div>
                <div id="productSearchResults" class="search-results-grid"></div>
            </div>
        </div>
    </div>
</div>

<script>
    // Dynamic API URL: Detect if we should use local server via '?local=true'
    const isLocal = new URLSearchParams(window.location.search).get('local') === 'true';
    const API_URL = isLocal ? 'http://localhost:3000/api' : 'https://exchange-return-tracking.onrender.com/api';
    console.log('🔗 Exchange API:', API_URL);
    let RAZORPAY_KEY_ID = null; // Will be fetched from backend
    let razorpayLoaded = false;

    let orderData = null;
    let productVariants = {}; 
    let selectedProducts = [];
    let selectedReplacements = {};
    let replacementProductsData = {}; // Map index -> full product data
    let currentSearchIndex = null;
    let priceDifference = 0;
    let searchTimeout = null;
    const EXCHANGE_FEE = 150;


    // Load Razorpay script dynamically
    function loadRazorpay() {
        return new Promise((resolve, reject) => {
            if (razorpayLoaded) {
                resolve();
                return;
            }
            const script = document.createElement('script');
            script.src = 'https://checkout.razorpay.com/v1/checkout.js';
            script.onload = () => {
                razorpayLoaded = true;
                resolve();
            };
            script.onerror = reject;
            document.head.appendChild(script);
        });
    }

    // Fetch configuration and check if exchanges are disabled
    fetch(`${API_URL}/config`)
        .then(r => r.json())
        .then(data => {
            RAZORPAY_KEY_ID = data.razorpayKey;
            
            // Disable the page if exchanges are turned off globally
            if (data.allowExchanges === false) {
                document.getElementById('lookupBtn').disabled = true;
                const emailInput = document.getElementById('email');
                emailInput.value = '';
                emailInput.disabled = true;
                const orderInput = document.getElementById('orderNumber');
                orderInput.value = '';
                orderInput.disabled = true;
                
                showAlert('Exchange requests are temporarily disabled by the administrator. Please try again later.', 'error');
            }
        })
        .catch(err => console.error('Failed to load config:', err));

    // Order Lookup
    document.getElementById('lookupForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const orderNumberEl = document.getElementById('orderNumber');
        const emailEl = document.getElementById('email');
        
        console.log('Lookup Form Elements:', { orderNumberEl, emailEl });
        
        if (!orderNumberEl || !emailEl) {
            console.error('Critical Error: Lookup form elements missing from DOM');
            showAlert('Form error. Please refresh the page.', 'error');
            showLoading('lookup', false);
            return;
        }

        const orderNumber = orderNumberEl.value;
        const email = emailEl.value;
        
        console.log('Lookup Data:', { orderNumber, email });

        showLoading('lookup', true);
        clearAlert();

        try {
            console.log('Fetching from:', `${API_URL}/lookup-order`);
            const response = await fetch(`${API_URL}/lookup-order`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderNumber, email })
            });
            const data = await response.json();

            if (response.ok) {
                if (!data.isEligible) {
                    showAlert(data.eligibilityMessage, 'error');
                    showLoading('lookup', false);
                    return;
                }
                orderData = data.order;
                productVariants = data.productVariants || {}; 
                displayOrderDetails();
                document.getElementById('lookupContainer').classList.add('hidden');
                document.getElementById('stepBarContainer').classList.remove('hidden');
                document.getElementById('mainContainer').classList.remove('hidden');
                document.getElementById('exchangeSection').classList.remove('hidden');
            } else {
                if (data.alreadyHasRequest) {
                    const trackUrl = '{{ routes.root_url }}pages/track-request';
                    showAlert(
                        `${data.eligibilityMessage} <a href="${trackUrl}" style="font-weight:600;text-decoration:underline;">Track your request &rarr;</a>`,
                        'error'
                    );
                } else {
                    showAlert(data.error || data.eligibilityMessage || 'Order not found', 'error');
                }
            }
        } catch (error) {
            showAlert('Failed to lookup order. Please try again.', 'error');
        } finally {
            showLoading('lookup', false);
        }
    });

    function displayOrderDetails() {
        document.getElementById('displayOrderNumber').textContent = orderData.orderNumber;
        const orderInfo = document.getElementById('orderInfo');
        let orderDateHtml = `<div><p style="font-size: 0.8rem; color: var(--gray-dark);">Order Date</p><p style="font-weight: 500;">${new Date(orderData.orderDate).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' })}</p></div>`;
        
        if (orderData.deliveredDate) {
            orderDateHtml += `<div><p style="font-size: 0.8rem; color: var(--gray-dark);">Delivered Date</p><p style="font-weight: 500; color: #166534;">${new Date(orderData.deliveredDate).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' })}</p></div>`;
        }

        orderInfo.innerHTML = `
            <div><p style="font-size: 0.8rem; color: var(--gray-dark);">Customer</p><p style="font-weight: 500;">${orderData.customerName}</p></div>
            ${orderDateHtml}
            <div><p style="font-size: 0.8rem; color: var(--gray-dark);">Total Amount</p><p style="font-weight: 500;">₹${orderData.totalAmount}</p></div>
        `;
        const currentAddress = document.getElementById('currentAddress');
        currentAddress.innerHTML = `
            <p style="font-size: 0.9rem; font-weight: 500; margin-bottom: 0.5rem;">${orderData.customerName}</p>
            <p style="font-size: 0.85rem; color: var(--gray-dark);">${orderData.shippingAddress}</p>
        `;
        const productGrid = document.getElementById('productGrid');
        productGrid.innerHTML = orderData.items.map((item, index) => `
            <div class="product-card" data-index="${index}" onclick="toggleProduct(${index})">
                <img src="${item.image || 'https://via.placeholder.com/200'}" alt="${item.name}" class="product-image">
                <div class="product-info">
                    <h3>${item.name}</h3>
                    <p>Size: ${item.variant || 'N/A'}</p>
                    <p>Quantity: ${item.quantity}</p>
                    <p class="product-price">₹${item.price}</p>
                </div>
                <div class="checkbox-wrapper">
                    <input type="checkbox" id="product-${index}" style="pointer-events: none;">
                    <label for="product-${index}" style="pointer-events: none;">Select for exchange</label>
                </div>
            </div>
        `).join('');
    }

    function toggleProduct(index) {
        const checkbox = document.getElementById(`product-${index}`);
        const card = document.querySelector(`[data-index="${index}"]`);
        if (selectedProducts.includes(index)) {
            selectedProducts = selectedProducts.filter(i => i !== index);
            checkbox.checked = false;
            card.classList.remove('selected');
        } else {
            selectedProducts.push(index);
            checkbox.checked = true;
            card.classList.add('selected');
        }
        updateReplacementOptions();
    }

    function updateReplacementOptions() {
        const replacementSection = document.getElementById('replacementSection');
        const replacementOptions = document.getElementById('replacementOptions');
        if (selectedProducts.length > 0) {
            replacementSection.classList.remove('hidden');
            replacementOptions.innerHTML = selectedProducts.map(index => {
                const originalItem = orderData.items[index];
                const originalPrice = parseFloat(originalItem.price);
                
                // Use custom selected product if available, otherwise original
                const currentProduct = replacementProductsData[index] || {
                    id: originalItem.productId,
                    title: originalItem.name,
                    image: originalItem.image,
                    variants: (productVariants[originalItem.productId] && productVariants[originalItem.productId].variants) || []
                };

                const pVariants = currentProduct.variants || [];
                let optionsHtml = '<option value="">Choose size/variant</option>';

                if (pVariants.length > 0) {
                    if (!pVariants || !Array.isArray(pVariants)) {
                        console.error('No variants found for product:', p.handle);
                        return '';
                    }
                    optionsHtml += pVariants.map(v => {
                        const isTracked = v.inventory_management === 'shopify';
                        const isOOS = isTracked && v.inventory_policy === 'deny' && v.inventory_quantity <= 0;
                        const disabledAttr = isOOS ? 'disabled' : '';
                        const labelText = v.title + (isOOS ? ' (Out of Stock)' : ` (₹${v.price})`);
                        return `<option value="${v.id}" data-title="${v.title}" data-price="${v.price}" ${disabledAttr}>${labelText}</option>`;
                    }).join('');
                } else {
                     optionsHtml += `<option value="Same" data-title="Same" data-price="${originalPrice}">Same as Original</option>`;
                }

                return `
                    <div style="background: var(--gray-light); padding: 1.25rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; border: 1px solid var(--gray-medium);">
                        <div style="display: flex; gap: 1rem; margin-bottom: 1rem; align-items: start;">
                            <img src="${currentProduct.image || 'https://via.placeholder.com/100'}" style="width: 60px; height: 60px; object-fit: cover; border-radius: var(--radius-sm);">
                            <div style="flex-grow: 1;">
                                <p style="font-weight: 500; font-size: 0.95rem; line-height: 1.4;">${currentProduct.title}</p>
                                <p style="font-size: 0.8rem; color: var(--gray-dark);">Exchanging: ${originalItem.name} (${originalItem.variant})</p>
                                <button type="button" class="btn-change-product" onclick="openSearchModal(${index})">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
                                    Change Product
                                </button>
                            </div>
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="replacement-${index}" style="font-size: 0.85rem;">Select Replacement Size/Variant</label>
                            <select id="replacement-${index}" class="replacement-select" data-index="${index}" data-original-price="${originalPrice}" onchange="calculatePriceDifference()">
                                ${optionsHtml.replace('value="' + (replacementProductsData[index] && replacementProductsData[index].selectedVariantId) + '"', 'value="' + (replacementProductsData[index] && replacementProductsData[index].selectedVariantId) + '" selected')}
                            </select>
                        </div>
                    </div>
                `;
            }).join('');
            calculatePriceDifference();
        } else {
            replacementSection.classList.add('hidden');
            priceDifference = 0;
            updateSubmitButton();
        }
    }

    function openSearchModal(index) {
        currentSearchIndex = index;
        document.getElementById('searchModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden'; // Prevent scroll
        document.getElementById('productSearchInput').focus();
        
        // Show initial products (featured/all)
        if (!document.getElementById('productSearchInput').value) {
            searchProducts(true);
        }
    }

    function closeSearchModal() {
        document.getElementById('searchModal').classList.add('hidden');
        document.body.style.overflow = '';
        document.getElementById('productSearchInput').value = '';
        document.getElementById('productSearchResults').innerHTML = '';
        currentSearchIndex = null;
    }

    function debounceSearch() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            searchProducts();
        }, 400);
    }

    async function searchProducts(isInitial = false) {
        const query = document.getElementById('productSearchInput').value.trim();
        const resultsDiv = document.getElementById('productSearchResults');
        const spinner = document.getElementById('productSearchSpinner');
        const sectionTitle = document.getElementById('searchSectionTitle');

        if (!isInitial && query.length < 2) {
            if (query.length === 0) searchProducts(true);
            return;
        }

        spinner.classList.remove('hidden');
        sectionTitle.textContent = isInitial ? 'Recommended Products' : `Search results for "${query}"`;

        try {
            const url = isInitial ? `${API_URL}/products/search` : `${API_URL}/products/search?q=${encodeURIComponent(query)}`;
            const response = await fetch(url);
            const products = await response.json();
            
            if (products.length === 0) {
                resultsDiv.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 4rem 1rem; color: var(--gray-dark);">No products found matching your search.</div>';
                return;
            }

            resultsDiv.innerHTML = products.map(p => {
                // Find min price from variants
                const minPrice = p.variants && p.variants.length > 0 
                    ? Math.min(...p.variants.map(v => parseFloat(v.price))) 
                    : 'N/A';

                const variantPills = (p.variants || []).map(v => {
                    const isTracked = v.inventory_management === 'shopify';
                    const isOOS = isTracked && v.inventory_policy === 'deny' && v.inventory_quantity <= 0;
                    return `<span class="size-pill ${isOOS ? 'disabled' : ''}" 
                                  onclick="event.stopPropagation(); if(!${isOOS}) selectNewProduct(${JSON.stringify(p).replace(/"/g, '&quot;')}, '${v.id}')">
                                ${v.title}
                            </span>`;
                }).join('');

                return `
                <div class="product-search-card" onclick="selectNewProduct(${JSON.stringify(p).replace(/"/g, '&quot;')})">
                    <img src="${p.image || 'https://via.placeholder.com/300'}" alt="${p.title}" loading="lazy">
                    <div class="info">
                        <h4 style="line-height: 1.2; margin-bottom: 0.25rem;">${p.title}</h4>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                            <span class="price-tag">₹${minPrice}</span>
                        </div>
                        <div class="size-pills">${variantPills}</div>
                    </div>
                </div>
                `;
            }).join('');
        } catch (error) {
            console.error('Search failed:', error);
            resultsDiv.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 4rem 1rem; color: var(--red);">Failed to connect. Please check your connection.</div>';
        } finally {
            spinner.classList.add('hidden');
        }
    }

    function selectNewProduct(product, variantId = null) {
        if (currentSearchIndex !== null) {
            replacementProductsData[currentSearchIndex] = product;
            if (variantId) {
                replacementProductsData[currentSearchIndex].selectedVariantId = variantId;
            }
            updateReplacementOptions();
            closeSearchModal();
        }
    }

    function calculatePriceDifference() {
        let itemDifference = 0;
        selectedProducts.forEach(index => {
            const item = orderData.items[index];
            const select = document.getElementById(`replacement-${index}`);
            if (select && select.value) {
                const selectedOption = select.options[select.selectedIndex];
                const newPrice = parseFloat(selectedOption.getAttribute('data-price') || item.price);
                const currentPrice = parseFloat(item.price);
                if (newPrice > currentPrice) {
                    itemDifference += (newPrice - currentPrice);
                }
            }
        });
        priceDifference = itemDifference;
        updateSubmitButton();
    }

    function updateSubmitButton() {
        const btnText = document.getElementById('submitBtnText');
        const reason = document.getElementById('exchangeReason').value;
        const imageHint = document.getElementById('imageHint');
        const commentHint = document.getElementById('commentHint');

        if (reason === 'defective' || reason === 'wrong_item') {
            imageHint.style.color = '#dc2626';
            imageHint.style.fontWeight = '500';
            imageHint.textContent = reason === 'defective' ? 'Photos are MANDATORY for damaged products.' : 'Photos are MANDATORY for wrong item received.';
            
            commentHint.style.color = '#dc2626';
            commentHint.style.fontWeight = '500';
            commentHint.textContent = reason === 'defective' ? 'A detailed description (at least 5 words) is MANDATORY for damaged products.' : 'A detailed description (at least 5 words) is MANDATORY for wrong item received.';
        } else {
            imageHint.style.color = 'var(--gray-dark)';
            imageHint.style.fontWeight = '400';
            imageHint.textContent = 'Upload photos if the product is damaged or defective';
            
            commentHint.style.color = 'var(--gray-dark)';
            commentHint.style.fontWeight = '400';
            commentHint.textContent = 'Provide details about your exchange';
        }

        let anySelected = false;
        selectedProducts.forEach(index => {
            const select = document.getElementById(`replacement-${index}`);
            if (select && select.value) anySelected = true;
        });

        if (anySelected) {
            let totalFee = EXCHANGE_FEE;
            let feeNote = `Fee: ₹${EXCHANGE_FEE}`;

            if (reason === 'defective' || reason === 'wrong_item') {
                totalFee = 0;
                feeNote = `Fee waived for ${reason === 'defective' ? 'damaged product' : 'wrong item'}`;
            }

            const totalPayable = priceDifference + totalFee;
            let text = `Pay ₹${totalPayable} & Exchange`;
            
            if (priceDifference > 0) {
                text += ` (Diff: ₹${priceDifference} + ${feeNote})`;
            } else {
                text += totalPayable > 0 ? ` (${feeNote})` : ` (No charge for damaged product)`;
            }
            btnText.textContent = text;
        } else {
            btnText.textContent = 'Submit Exchange Request';
        }
    }

    // Update button when reason changes
    document.getElementById('exchangeReason').addEventListener('change', updateSubmitButton);

    function toggleAddressChange() {
        const checked = document.getElementById('changeAddress').checked;
        document.getElementById('newAddressSection').classList.toggle('hidden', !checked);
    }

    async function submitExchangeForm() {
        if (selectedProducts.length === 0) {
            showAlert('Please select at least one item to exchange', 'error');
            return;
        }

        const reason = document.getElementById('exchangeReason').value;
        const comments = document.getElementById('exchangeComments').value.trim();
        const images = document.getElementById('exchangeImages').files;

        if (reason === 'defective' || reason === 'wrong_item') {
            if (images.length === 0) {
                showAlert('Please upload at least one photo showing the damage.', 'error');
                return;
            }
            const wordCount = comments.split(/\s+/).filter(word => word.length > 0).length;
            if (wordCount < 5) {
                showAlert(`Please provide a detailed description (at least 5 words). Current: ${wordCount} words.`, 'error');
                return;
            }
        }

        let allSelected = true;
        selectedProducts.forEach(index => {
            const select = document.getElementById(`replacement-${index}`);
            if (!select || !select.value) allSelected = false;
        });

        if (!allSelected) {
            showAlert('Please select replacement options for all items', 'error');
            return;
        }

        // Populate selectedReplacements
        selectedProducts.forEach(index => {
            const select = document.getElementById(`replacement-${index}`);
            const selectedOption = select.options[select.selectedIndex];
            selectedReplacements[index] = {
                variantId: select.value,
                title: selectedOption.getAttribute('data-title'),
                price: selectedOption.getAttribute('data-price')
            };
        });

        const totalFee = (reason === 'defective' || reason === 'wrong_item') ? 0 : EXCHANGE_FEE;
        const totalPayable = priceDifference + totalFee;
        processExchangeSubmission(null);
    }

    async function initiatePayment(requestId, amount) {
        if (!RAZORPAY_KEY_ID) {
            try {
                const res = await fetch(`${API_URL}/config`);
                const data = await res.json();
                RAZORPAY_KEY_ID = data.razorpayKey;
            } catch (e) {
                console.error('Failed to retry fetching config:', e);
            }
        }

        if (!RAZORPAY_KEY_ID || RAZORPAY_KEY_ID === '') {
             RAZORPAY_KEY_ID = "{{ settings.razorpay_key_id }}";
        }

        if (!RAZORPAY_KEY_ID) {
            showAlert('Payment Gateway Configuration Missing. Please contact support.', 'error');
            return;
        }

        try {
            await loadRazorpay();
        } catch (err) {
            showAlert('Failed to load payment gateway. Please try again.', 'error');
            return;
        }
        
        const options = {
            "key": RAZORPAY_KEY_ID,
            "amount": amount * 100,
            "currency": "INR",
            "name": "{{ shop.name }}",
            "description": "Exchange Price Difference",
            "notes": {
                "requestId": requestId
            },
            "handler": async function (response) {
                console.log('✅ Payment successful:', response.razorpay_payment_id);
                try {
                    await fetch(`${API_URL}/finalize-payment`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            requestId,
                            paymentId: response.razorpay_payment_id,
                            paymentAmount: amount
                        })
                    });
                } catch (e) {
                    console.error('Finalize call failed (likely will be caught by webhook):', e);
                }
                showSuccess(requestId);
            },
            "prefill": {
                "name": orderData.customerName,
                "email": orderData.email,
                "contact": orderData.phone
            },
            "theme": { "color": "#000000" },
            "modal": {
                "ondismiss": function () {
                    showLoading('submit', false);
                    showAlert('Payment cancelled. Exchange request not submitted.', 'error');
                }
            }
        };
        const rzp1 = new Razorpay(options);
        rzp1.open();
    }

    async function processExchangeSubmission(paymentId) {
        const reason = document.getElementById('exchangeReason').value;
        const totalFee = (reason === 'defective' || reason === 'wrong_item') ? 0 : EXCHANGE_FEE;
        const totalPayable = priceDifference + totalFee;

        const formData = new FormData();
        formData.append('orderNumber', orderData.orderNumber);
        formData.append('email', orderData.email);
        formData.append('customerName', orderData.customerName);
        formData.append('customerPhone', orderData.phone);
        formData.append('items', JSON.stringify(selectedProducts.map(i => {
            const originalItem = orderData.items[i];
            const replacementProduct = replacementProductsData[i];
            return {
                ...originalItem,
                replacementVariant: selectedReplacements[i].title, // Keep for backward compatibility/logging
                replacementVariantId: selectedReplacements[i].variantId,
                replacementProductId: replacementProduct ? replacementProduct.id : originalItem.productId,
                replacementProductTitle: replacementProduct ? replacementProduct.title : originalItem.name
            };
        })));
        formData.append('reason', reason);
        formData.append('comments', document.getElementById('exchangeComments').value);
        
        if (paymentId) {
            formData.append('paymentId', paymentId);
            formData.append('paymentAmount', totalPayable);
        }
        
        if (document.getElementById('changeAddress').checked) {
            formData.append('newAddress', document.getElementById('newAddress').value);
            formData.append('newCity', document.getElementById('newCity').value);
            formData.append('newPincode', document.getElementById('newPincode').value);
        }
        
        const images = document.getElementById('exchangeImages').files;
        for (let i = 0; i < images.length; i++) {
            formData.append('images', images[i]);
        }
        
        showLoading('submit', true);
        try {
            console.log('📤 Submitting exchange request...');
            const response = await fetch(`${API_URL}/submit-exchange`, {
                method: 'POST',
                body: formData
            });
            const data = await response.json();

            if (response.ok) {
                if (data.requestId && !paymentId && totalPayable > 0) {
                    initiatePayment(data.requestId, totalPayable);
                } else {
                    showSuccess(data.requestId);
                }
            } else {
                showAlert(data.error || 'Failed to submit exchange request', 'error');
                showLoading('submit', false);
            }
        } catch (error) {
            console.error('Submission error:', error);
            showAlert('Failed to connect to server. Please try again.', 'error');
            showLoading('submit', false);
        }
    }

    function showSuccess(requestId) {
        document.getElementById('requestId').textContent = requestId;
        document.getElementById('exchangeSection').classList.add('hidden');
        if (document.getElementById('stepBarContainer')) {
            document.getElementById('stepBarContainer').classList.add('hidden');
        }
        document.getElementById('successSection').classList.remove('hidden');
        window.scrollTo(0, 0);
        showLoading('submit', false);
    }

    document.getElementById('exchangeForm').addEventListener('submit', (e) => {
        e.preventDefault();
        submitExchangeForm();
    });

    function showLoading(type, show) {
        const btn = type === 'lookup' ? 'lookupBtn' : 'submitBtn';
        const text = type === 'lookup' ? 'lookupBtnText' : 'submitBtnText';
        const spinner = type === 'lookup' ? 'lookupSpinner' : 'submitSpinner';
        document.getElementById(btn).disabled = show;
        document.getElementById(text).classList.toggle('hidden', show);
        document.getElementById(spinner).classList.toggle('hidden', !show);
    }

    function showAlert(message, type) {
        const alertContainer = document.getElementById('alertContainer');
        alertContainer.innerHTML = `<div class="alert alert-${type}">${message}</div>`;
        window.scrollTo(0, 0);
    }

    function clearAlert() {
        document.getElementById('alertContainer').innerHTML = '';
    }

    // Fix for "Cannot read properties of null (reading 'find')"
    // This function seems to be expected by some external script or event listener
    window.initializeSelections = function() {
        console.log('initializeSelections called');
        if (!orderData || !orderData.items) {
            console.log('Order data not loaded yet, skipping selection initialization');
            return;
        }
        // Logic to restore selections if needed, or just a placeholder to prevent crash
        // If we want to support pre-selection from URL/Storage:
        try {
            const urlParams = new URLSearchParams(window.location.search);
            const variantId = urlParams.get('variant');
            if (variantId) {
                const itemIndex = orderData.items.findIndex(item => item.variantId == variantId);
                if (itemIndex >= 0) {
                    toggleProduct(itemIndex);
                }
            }
        } catch (e) {
            console.error('Error in initializeSelections:', e);
        }
    };

    // Call it when order is loaded
    // We already call displayOrderDetails, we can call it there too if needed
    // But sticking it on window ensures global access if something else calls it.
</script>
